    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    </head>
    <body>
        <div class="w-full min-h-screen bg-zinc-900 text-white ">
            <nav class="px-12  flex justify-between items-center border-b-1 border-zinc-800 h-16 w-full">
                <h1 class="text-2xl font-bold">Emigram</h1>
                <div class="flex gap-10">
                    <a href="/profile" class="text-md font-semibold">Your Profile</a>
                    <a href="/feed" class="text-md font-semibold">Your Feed</a>
                </div>
                <a href="/logout" class="text-md font-semibold">logout</a>
            </nav>
            <div class="px-12 w-full mt-12">
                
                <%user.following.forEach((user)=>{%>
                    <div class="w-1/3 border-1 mb-2 border-zinc-700 rounded-md px-5 py-2 flex items-center justify-between">
                        <a class="text-blue-500 italic">@<%=user.username%></a>
                        <div class="flex  gap-6 text-zinc-300 items-center">
                    <h3>posts <span class="text-white font-bold"><%=user.posts.length%></span></h3>
                    <h3><a href="/profile/followers/<%=user._id%>">followers</a> <span claass="text-white font-bold"><%=user.followers.length%></span></h3>
                    <h3>following <span class="text-white font-bold"><%=user.following.length%></span></h3>
                    <a href="/following/unfollow/<%=user._id%>" class="py-1 px-3 text-sm border-1 border-zinc-600 rounded-md" href="">unfollow</a>
                </div>
                </div>
                <%})%>
            </div>
        </div>
    </body>
    </html>