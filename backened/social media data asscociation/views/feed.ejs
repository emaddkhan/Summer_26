<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white">
      <nav
        class="px-12 flex justify-between items-center border-b-1 border-zinc-800 h-16 w-full"
      >
        <h1 class="text-2xl font-bold">Emigram</h1>
        <a href="/feed" class="text-md font-semibold">Your Feed</a>
        <a href="/logout" class="text-md font-semibold">logout</a>
      </nav>
      <div class="postContainer w-1/3 mx-auto flex flex-col gap-2">
        <% posts.forEach((post) => { %>

    <div class="bg-transparent border border-zinc-700 rounded-md w-full mt-5 px-3 py-5">

        <a href="/profile/<%=post.user._id%>" class="text-blue-500 italic">
            @<%= post.user.username %>
        </a>

        <p class="text-sm mt-2">
            <%= post.content %>
        </p>

        <div class="mt-2 flex justify-between">

            <a href="/feed/like/<%= post._id %>">
                <span class="mr-1">
                    <%= post.likes.length %>
                </span>

                <%= post.likes.some(id => id.toString() === user._id.toString())
                    ? "Unlike"
                    : "Like" %>
            </a>

            

        </div>

    </div>

<% }) %>
        
      </div>
    </div>
  </body>
</html>
