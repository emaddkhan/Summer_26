<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white flex justify-center items-center">
        <div class="py-2 w-1/4 px-3 bg-transparent border-1  border-zinc-700 rounded-md ">
            <h1 class="text-center text-lg font-semibold">Sign up to your account</h1>
            <form action="/register" method="post" class="flex flex-col gap-2 mt-5 items-center">
                <input class="block w-full px-3 py-2 rounded-md bg-transparent border-1 border-zinc-800  outline-none" type="text" placeholder="username" name="username">
                <div class="flex gap-2 w-full">
                    <input class="w-[75%] px-3 py-2 rounded-md bg-transparent border-1 border-zinc-800 outline-none" type="text" placeholder="name" name="name">
                    <input class="w-[25%] px-3 py-2 rounded-md bg-transparent border-1 border-zinc-800 outline-none" type="number" placeholder="Age" name="age">
                </div>
                <input class="block w-full px-3 py-2 rounded-md bg-transparent border-1 border-zinc-800  outline-none" type="email" placeholder="Email" name="email">
                <input class="block w-full px-3 py-2 rounded-md bg-transparent border-1 border-zinc-800  outline-none" type="password" placeholder="Password" name="password">
                <input class="px-3 py-2 bg-blue-500 w-1/4 mt-1 rounded-md" type="submit" value="Sign up">
            </form>
            <p class="text-center mt-1 text-zinc-600">or</p>
            <div class="w-full  flex justify-center">
                <a href="/" class="text-zinc-600 text-center mx-a hover:text-blue-500 ">Sign in</a>
            </div>
        </div>
    </div>
</body>
</html>