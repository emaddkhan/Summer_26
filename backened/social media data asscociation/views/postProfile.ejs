<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white ">
        <nav class="px-12  flex justify-between items-center border-b-1 border-zinc-800 h-16 w-full">
            <h1 class="text-2xl font-bold">Emigram</h1>
            <a href="/feed" class="text-md font-semibold">Your Feed</a>
            <a href="/logout" class="text-md font-semibold">logout</a>
        </nav>
        <div class="px-12 w-full mt-12  border-b-1 border-zinc-800 pb-12 ">
            <h1 class="text-xl font-semibold">Hi, <%=user.name%></h1>
            <div class="w-full py-2 flex items-center gap-6 text-zinc-300">
                <h3>posts <span class="text-white font-bold"><%=user.posts.length%></span></h3>
                <h3>followers <span class="text-white font-bold"><%=user.followers.length%></span></h3>
                <h3>following <span class="text-white font-bold"><%=user.following.length%></span></h3>
                <a href="/follow/<%=user._id%>" class="py-1 px-2 border-1 border-zinc-600 rounded-md text-sm"><%=user.followers.indexOf(currentUser._id)===-1?"follow":"unfollow"%></a>
            </div>
        </div>
        <div class="px-12 w-full mt-6" >
            <h1 class="text-xl font-semibold">Their posts</h1>
            <div class="postContainer flex flex-col gap-2">
                
                <%user.posts.forEach((post)=>{%>
                 <div class="bg-transparent border-1 border-zinc-700 rounded-md w-1/4 mt-5 px-3 py-5">
                    <a class="text-blue-500 italic">@<%=user.username%></a>
                    <p class="text-sm mt-2"><%=post.content%></p>
                    <div class="mt-2 flex justify-between ">
                        <a href="/like/<%=post._id%>"><span class="mr-1"><%=post.likes.length%></span><%=post.likes.indexOf(user._id)===-1?"Like":"UnLike" %> </a>
                        <a href="/edit/<%=post._id%>"> edit</a>
                    </div>
                 </div>
               <%})%>
            </div>
        </div>
    </div>
</body>
</html>