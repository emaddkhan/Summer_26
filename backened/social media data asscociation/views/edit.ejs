<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white ">
        <nav class="px-12  flex justify-between items-center border-b-1 border-zinc-800 h-16 w-full">
            <h1 class="text-2xl font-bold">Emigram</h1>
            <a href="/feed" class="text-md font-semibold">Your Feed</a>
            <a href="/logout" class="text-md font-semibold">logout</a>
        </nav>
        <form action="/post/<%=post._id%>" method="post" class="mt-12 px-12">
                <textarea name="content" placeholder="What is on your mind??" class="w-1/4 px-5 py-3 bg-transparent border-2 border-zinc-700 rounded-md resize-none"><%=post.content%></textarea>
                <input class="block mt-2 bg-yellow-600 rounded-md px-5 py-2" type="submit" value="Update">
        </form>
    </div>
</body>
</html>