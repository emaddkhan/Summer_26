<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen text-white bg-zinc-900 p-10">
        <div class="flex justify-end w-full">
          <a class="px-3 py-2 bg-red-500 rounded-md" href="/logout">Logout</a>
        </div>
        <h1 class="text-3xl ">Hello,<%=user.name %></h1>
        <h4 class="mb-5">you can create a new post</h4>
        <form method="post" action="/post">
            <textarea placeholder="What's on your mind?"  class="block px-3 py-2 w-1/4 bg-transparent border-1 outline-none boder-zinc-800 resize-none rounded-md" name="content"></textarea>
            <input class="block px-3 py-2 bg-blue-500 mt-2 rounded-md w-40" type="submit" value="Create new post">
        </form>

        <div class="posts mt-20">
            <h3 class="text-xl text-zinc-400">Your Posts</h3>
            <div class="postContainer mt-5">
               <% user.posts.reverse().forEach((post) => { %>

    <div class="post mb-2 w-1/3 border-2 border-zinc-700 p-2 bg-zinc-800 rounded-md">
        <h4 class="text-lg font-semibold mb-1 text-blue-500">
            <%= user.username %>
        </h4>

        <p class="text-sm tracking-tight">
            <%= post.content %>
        </p>

        <div class="btns flex gap-4 mt-2">
            <a href="/like/<%=post._id%>" class="text-blue-500 "><span class="text-white"><%=post.likes.length%></span> <%=post.likes.indexOf(user._id)===-1?"Likes":"Unlike"%></a>
            <a href="/edit/<%=post._id%>" class="text-zinc-500">Edit</a>
        </div>
    </div>

<% }) %>
                
            </div>
        </div>

    </div>
    
</body>
</html>