<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen text-white bg-zinc-900 p-10">
        <h1 class="text-3xl mb-5">Login Acoount</h1>
        <form action="/login" method="post">
            <input type="email" class="px-5 py-2 bg-transparent border-2 border-zinc-700 outline-none rounded-md" placeholder="email" name="email">
            <input type="password" class="px-5 py-2 bg-transparent border-2 border-zinc-700 outline-none rounded-md" placeholder="password" name="password">
            <input type="submit" class="bg-blue-500 px-5 py-2 rounded-md" value="Login">
        </form>
    </div>
</body>
</html>