<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MINI HRMS - Employee Dashboard</title>

    <!-- Fonts and Icons -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Tailwind Config -->
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "surface-bright": "#fbf8ff",
              "surface-container-lowest": "#ffffff",
              "secondary-fixed-dim": "#adc6ff",
              "on-tertiary": "#ffffff",
              "surface-container-highest": "#e3e1ec",
              "tertiary-fixed": "#ebe0df",
              secondary: "#0058be",
              "on-secondary-container": "#fefcff",
              "on-secondary-fixed-variant": "#004395",
              "secondary-container": "#2170e4",
              "secondary-fixed": "#d8e2ff",
              "surface-variant": "#e3e1ec",
              primary: "#000000",
              "error-container": "#ffdad6",
              error: "#ba1a1a",
              "surface-container": "#eeedf7",
              "primary-fixed-dim": "#c8c6c8",
              "on-tertiary-fixed-variant": "#4c4545",
              "primary-container": "#1c1b1d",
              "surface-container-high": "#e8e7f1",
              "inverse-primary": "#c8c6c8",
              "surface-dim": "#dad9e3",
              "on-secondary": "#ffffff",
              "tertiary-container": "#1f1a1a",
              background: "#fbf8ff",
              "on-error-container": "#93000a",
              "on-tertiary-fixed": "#1f1a1a",
              tertiary: "#000000",
              outline: "#78767b",
              "on-primary": "#ffffff",
              "on-background": "#1a1b22",
              "on-secondary-fixed": "#001a42",
              "on-error": "#ffffff",
              "on-primary-fixed": "#1c1b1d",
              "on-surface-variant": "#47464a",
              "on-tertiary-container": "#8a8282",
              "on-surface": "#1a1b22",
              "on-primary-fixed-variant": "#474649",
              "tertiary-fixed-dim": "#cec4c4",
              "inverse-surface": "#2f3038",
              "inverse-on-surface": "#f1effa",
              surface: "#fbf8ff",
              "outline-variant": "#c8c5ca",
              "surface-tint": "#5f5e60",
              "surface-container-low": "#f4f2fd",
              "primary-fixed": "#e5e1e4",
              "on-primary-container": "#858386",
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
            spacing: {
              "stack-md": "1rem",
              "margin-page": "2rem",
              "container-max": "1440px",
              "stack-sm": "0.5rem",
              gutter: "1.5rem",
              "stack-lg": "2rem",
            },
            fontFamily: {
              "label-sm": ["Geist"],
              "headline-lg": ["Geist"],
              "headline-md": ["Geist"],
              "body-lg": ["Geist"],
              "label-md": ["Geist"],
              "headline-xl": ["Geist"],
              "body-md": ["Geist"],
            },
            fontSize: {
              "label-sm": ["11px", { lineHeight: "14px", fontWeight: "600" }],
              "headline-lg": [
                "24px",
                {
                  lineHeight: "32px",
                  letterSpacing: "-0.01em",
                  fontWeight: "600",
                },
              ],
              "headline-md": [
                "18px",
                { lineHeight: "28px", fontWeight: "600" },
              ],
              "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
              "label-md": [
                "12px",
                {
                  lineHeight: "16px",
                  letterSpacing: "0.01em",
                  fontWeight: "500",
                },
              ],
              "headline-xl": [
                "36px",
                {
                  lineHeight: "44px",
                  letterSpacing: "-0.02em",
                  fontWeight: "600",
                },
              ],
              "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Geist", sans-serif;
        background-color: #fafafa;
      }
      .ghost-border {
        border: 1px solid #e4e4e7;
      }
      .ghost-border:hover {
        border-color: #d1d1d6;
      }
      ::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>

  <body class="bg-surface text-on-surface h-screen overflow-hidden flex">
    <!-- Common Employee Sidebar -->
    <%- include('partials/empSidebar') %>

    <!-- Main Content Wrapper -->
    <div class="flex-1 ml-60 flex flex-col h-screen overflow-hidden">
      <!-- TopAppBar -->
      <header
        class="flex justify-between items-center h-16 px-gutter bg-surface-bright dark:bg-surface-dim border-b border-outline-variant dark:border-outline shrink-0 z-10"
      >
        <div class="flex items-center gap-4">
          <div
            class="relative focus-within:ring-2 focus-within:ring-outline-variant rounded-full transition-all duration-200 ease-in-out"
          >
            <span
              class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]"
            >
              search
            </span>
            <input
              class="pl-9 pr-4 py-1.5 bg-surface-container-lowest border border-outline-variant rounded-full text-body-md font-body-md text-on-surface placeholder-outline focus:outline-none w-64"
              placeholder="Search..."
              type="text"
            />
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button
            class="p-2 rounded-full text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined"> notifications </span>
          </button>
          <div
            class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant"
          >
            <img
              class="w-full h-full object-cover"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBjzDBz1Kn2fX2DGF8tQbLxLAU1Ln9SZXTJ6YEqw0sZCOuGPZ9_FvCA9xn5Hx3zN063d2h5e5QdbzWkQa9dz_vw40yeWqVhYK2oq11yEFYUjd2uskvED8-nPefuyqbBg9Snj-TwI1OL7pOdguuSibYvgROQNvr2ljEW4I-wZ3LX5y8yHVPBjQZP9uBCW0GVE9_G1kJ18FY2BoibIjk9sNqzh4OiVUX98FSalqvm_ZVl1ugY5Fpn-dsg"
            />
          </div>
        </div>
      </header>

      <!-- Main Scrollable Content -->
      <main class="flex-1 overflow-y-auto p-margin-page">
        <div class="max-w-[1440px] mx-auto flex flex-col gap-stack-lg">
          <!-- Page Header -->
          <div
            class="mb-stack-lg flex flex-col sm:flex-row sm:items-end justify-between gap-4"
          >
            <div>
              <h1
                class="text-headline-xl font-headline-xl text-primary tracking-tight"
              >
                Good morning, <%=user.fullname%> 👋
              </h1>
              <p class="text-body-lg font-body-lg text-on-surface-variant mt-1">
                Here is a summary of your account and leave status.
              </p>
            </div>
            <div class="flex gap-3">
              <button
                class="bg-[#09090b] text-[#ffffff] px-4 py-2 rounded-lg text-label-md font-label-md transition-all hover:bg-primary-container flex items-center gap-2 cursor-pointer"
                id="openApplyLeaveModalBtn"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]">add</span>
                Apply Leave
              </button>
            </div>
          </div>

          <!-- Dashboard Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: Profile & Actions (lg: 4 cols) -->
            <div class="lg:col-span-4 flex flex-col gap-6">
              <!-- Profile Card -->
              <div
                class="bg-surface-container-lowest ghost-border rounded-xl p-6 transition-colors duration-200 relative overflow-hidden flex flex-col items-center text-center"
              >
                <div
                  class="absolute top-0 left-0 w-full h-24 bg-surface-container-low -z-10"
                ></div>
                <div class="relative mb-4 mt-6">
                  <img
                    class="w-24 h-24 rounded-full object-cover border-4 border-surface-container-lowest shadow-sm z-10 relative"
                    src="data:<%=user.imageType%>;base64,<%=user.profileImage.toString('base64')%>"
                  />
                  <span
                    class="absolute bottom-0 right-0 w-6 h-6 bg-surface-container-lowest border border-outline-variant rounded-full flex items-center justify-center z-20"
                  >
                    <span
                      class="material-symbols-outlined text-[14px] text-[#065f46]"
                      >check_circle</span
                    >
                  </span>
                </div>

                <h2 class="text-headline-md font-headline-md text-primary mb-1">
                  <%=user.fullname%>
                </h2>
                <p
                  class="text-body-md font-body-md text-on-surface-variant mb-4"
                >
                  <%=user.email%>
                </p>

                <div
                  class="inline-block bg-surface-container px-3 py-1 rounded-full text-label-sm font-label-sm text-primary mb-6"
                >
                  <%=user.role%>
                </div>

                <div class="w-full space-y-3 text-left">
                  <div
                    class="flex items-center gap-3 p-3 rounded-lg bg-[#fafafa] border border-outline-variant border-opacity-50"
                  >
                    <span
                      class="material-symbols-outlined text-outline text-[18px]"
                      >call</span
                    >
                    <span class="text-body-md font-body-md text-on-surface">
                      <%=user.phone%>
                    </span>
                  </div>
                  <div
                    class="flex items-center gap-3 p-3 rounded-lg bg-[#fafafa] border border-outline-variant border-opacity-50"
                  >
                    <span
                      class="material-symbols-outlined text-outline text-[18px]"
                      >location_on</span
                    >
                    <span class="text-body-md font-body-md text-on-surface">
                      <%=user.address%>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Secondary Actions Panel -->
              <div
                class="bg-surface-container-lowest ghost-border rounded-xl p-4 flex flex-col gap-2"
              >
                <h3
                  class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider mb-2 px-2"
                >
                  Quick Links
                </h3>
                <button
                  class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-[#f4f4f5] transition-colors group text-left border border-transparent"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-md bg-surface flex items-center justify-center border border-outline-variant group-hover:border-[#d1d1d6] transition-colors"
                    >
                      <span
                        class="material-symbols-outlined text-[18px] text-primary"
                        >calendar_month</span
                      >
                    </div>
                    <span class="text-body-md font-body-md text-primary"
                      >View My Leaves</span
                    >
                  </div>
                  <span
                    class="material-symbols-outlined text-[18px] text-outline opacity-0 group-hover:opacity-100 transition-opacity transform translate-x-[-4px] group-hover:translate-x-0"
                    >arrow_forward</span
                  >
                </button>
                <button
                  class="w-full flex items-center justify-between p-3 rounded-lg hover:bg-[#f4f4f5] transition-colors group text-left border border-transparent"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-md bg-surface flex items-center justify-center border border-outline-variant group-hover:border-[#d1d1d6] transition-colors"
                    >
                      <span
                        class="material-symbols-outlined text-[18px] text-primary"
                        >person</span
                      >
                    </div>
                    <span class="text-body-md font-body-md text-primary"
                      >Edit My Profile</span
                    >
                  </div>
                  <span
                    class="material-symbols-outlined text-[18px] text-outline opacity-0 group-hover:opacity-100 transition-opacity transform translate-x-[-4px] group-hover:translate-x-0"
                    >arrow_forward</span
                  >
                </button>
              </div>
            </div>

            <!-- Right Column: Stats & Tables (lg: 8 cols) -->
            <div class="lg:col-span-8 flex flex-col gap-6">
              <!-- Leave Statistics Bento Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Total -->
                <div
                  class="bg-surface-container-lowest ghost-border rounded-xl p-5 flex flex-col justify-between h-32 relative overflow-hidden group hover:border-[#d1d1d6] transition-colors"
                >
                  <div class="flex justify-between items-start">
                    <span
                      class="text-body-md font-body-md text-on-surface-variant"
                      >Total Leaves</span
                    >
                    <span class="material-symbols-outlined text-outline"
                      >calendar_today</span
                    >
                  </div>
                  <div class="flex items-end justify-between">
                    <span
                      class="text-headline-xl font-headline-xl text-primary leading-none"
                    >
                      <%=user.leaves.totalLeaves.length%>
                    </span>
                    <span class="text-label-sm font-label-sm text-outline"
                      >Days</span
                    >
                  </div>
                </div>
                <!-- Approved -->
                <div
                  class="bg-surface-container-lowest ghost-border rounded-xl p-5 flex flex-col justify-between h-32 relative overflow-hidden group hover:border-[#d1d1d6] transition-colors"
                >
                  <div
                    class="absolute inset-0 bg-[#ecfdf5] opacity-20 group-hover:opacity-30 transition-opacity"
                  ></div>
                  <div class="flex justify-between items-start relative z-10">
                    <span
                      class="text-body-md font-body-md text-on-surface-variant"
                      >Approved</span
                    >
                    <span class="material-symbols-outlined text-[#065f46]"
                      >check_circle</span
                    >
                  </div>
                  <div class="flex items-end justify-between relative z-10">
                    <span
                      class="text-headline-xl font-headline-xl text-[#065f46] leading-none"
                    >
                      <%=user.leaves.approvedLeaves.length%>
                    </span>
                    <span
                      class="text-label-sm font-label-sm text-[#065f46] opacity-70"
                      >Days</span
                    >
                  </div>
                </div>
                <!-- Pending -->
                <div
                  class="bg-surface-container-lowest ghost-border rounded-xl p-5 flex flex-col justify-between h-32 relative overflow-hidden group hover:border-[#d1d1d6] transition-colors"
                >
                  <div
                    class="absolute inset-0 bg-[#fffbeb] opacity-30 group-hover:opacity-40 transition-opacity"
                  ></div>
                  <div class="flex justify-between items-start relative z-10">
                    <span
                      class="text-body-md font-body-md text-on-surface-variant"
                      >Pending</span
                    >
                    <span class="material-symbols-outlined text-[#92400e]"
                      >hourglass_empty</span
                    >
                  </div>
                  <div class="flex items-end justify-between relative z-10">
                    <span
                      class="text-headline-xl font-headline-xl text-[#92400e] leading-none"
                    >
                      <%=user.leaves.totalLeaves.length%>
                    </span>
                    <span
                      class="text-label-sm font-label-sm text-[#92400e] opacity-70"
                      >Requests</span
                    >
                  </div>
                </div>
              </div>

              <!-- Recent Leave Requests Table Card -->
              <div
                class="bg-surface-container-lowest ghost-border rounded-xl overflow-hidden flex flex-col flex-1"
              >
                <div
                  class="p-6 border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest"
                >
                  <h2 class="text-headline-md font-headline-md text-primary">
                    Recent Leave Requests
                  </h2>
                  <button
                    class="text-label-md font-label-md text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1"
                  >
                    View All
                    <span class="material-symbols-outlined text-[16px]"
                      >arrow_forward</span
                    >
                  </button>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="bg-[#fafafa] border-b border-outline-variant">
                        <th
                          class="py-3 px-6 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider font-semibold"
                        >
                          Leave Type
                        </th>
                        <th
                          class="py-3 px-6 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider font-semibold"
                        >
                          Start Date
                        </th>
                        <th
                          class="py-3 px-6 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider font-semibold"
                        >
                          End Date
                        </th>
                        <th
                          class="py-3 px-6 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider font-semibold text-right"
                        >
                          Status
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        <% user.leaves.totalLeaves.forEach((leave) =>{%>
                            <tr
                        class="hover:bg-[#fbfbfb] transition-colors group h-[52px]"
                      >
                        <td class="py-3 px-6">
                          <div class="flex items-center gap-3">
                            <div
                              class="w-2 h-2 rounded-full bg-secondary"
                            ></div>
                            <span
                              class="text-body-md font-body-md text-primary font-medium"
                              >Annual Leave</span
                            >
                          </div>
                        </td>
                        <td
                          class="py-3 px-6 text-body-md font-body-md text-on-surface-variant"
                        >
                          Oct 12, 2023
                        </td>
                        <td
                          class="py-3 px-6 text-body-md font-body-md text-on-surface-variant"
                        >
                          Oct 15, 2023
                        </td>
                        <td class="py-3 px-6 text-right">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#ecfdf5] text-[#065f46] border border-[#d1fae5]"
                          >
                            Approved
                          </span>
                        </td>
                      </tr>
                       <% })%>
                      
                      
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- APPLY LEAVE MODAL POPUP -->
    <div
      class="fixed inset-0 z-50 hidden bg-inverse-surface/40 backdrop-blur-sm flex items-center justify-center p-4"
      id="applyLeaveModal"
    >
      <div
        class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-outline-variant flex flex-col gap-5 transition-all transform scale-100"
      >
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-outline-variant/60 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[22px]">event_note</span>
            </div>
            <div>
              <h3 class="font-headline-md text-headline-md text-on-surface">Apply for Leave</h3>
              <p class="font-label-sm text-label-sm text-on-surface-variant">Submit a new time-off request for approval</p>
            </div>
          </div>

          <button
            class="w-8 h-8 rounded-lg flex items-center justify-center text-on-surface-variant hover:bg-surface-container transition-colors"
            id="closeApplyLeaveModalBtn"
            type="button"
          >
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>

        <!-- Modal Form -->
        <form action="/employee/leave/create" method="POST" class="flex flex-col gap-4">
          <!-- Leave Type Dropdown -->
          <div class="flex flex-col gap-1.5">
            <label class="font-label-md text-label-md text-on-surface font-medium">Leave Type</label>
            <select
              name="leaveType"
              class="w-full bg-surface-bright border border-outline-variant rounded-lg px-3.5 py-2.5 text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
              required
            >
              <option value="" disabled selected>Select type of leave</option>
              <option value="Annual Leave">Annual Leave</option>
              <option value="Sick Leave">Sick Leave</option>
              <option value="Casual Leave">Casual Leave</option>
              <option value="Unpaid Leave">Unpaid Leave</option>
            </select>
          </div>

          <!-- Date Range Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label class="font-label-md text-label-md text-on-surface font-medium">Start Date</label>
              <input
                type="date"
                name="startDate"
                class="w-full bg-surface-bright border border-outline-variant rounded-lg px-3.5 py-2 text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                required
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="font-label-md text-label-md text-on-surface font-medium">End Date</label>
              <input
                type="date"
                name="endDate"
                class="w-full bg-surface-bright border border-outline-variant rounded-lg px-3.5 py-2 text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                required
              />
            </div>
          </div>

          <!-- Reason Textarea -->
          <div class="flex flex-col gap-1.5">
            <label class="font-label-md text-label-md text-on-surface font-medium">Reason / Description</label>
            <textarea
              name="reason"
              rows="3"
              placeholder="Briefly explain the reason for your time-off request..."
              class="w-full bg-surface-bright border border-outline-variant rounded-lg p-3 text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-none"
              required
            ></textarea>
          </div>

          <!-- Modal Actions -->
          <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant/60">
            <button
              class="px-4 py-2 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-colors"
              id="cancelApplyLeaveModalBtn"
              type="button"
            >
              Cancel
            </button>

            <button
              class="px-5 py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary/90 transition-all flex items-center gap-2"
              type="submit"
            >
              <span class="material-symbols-outlined text-[18px]">send</span>
              Submit Request
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal JavaScript Script -->
    <script>
      const applyLeaveModal = document.getElementById('applyLeaveModal');
      const openApplyLeaveBtn = document.getElementById('openApplyLeaveModalBtn');
      const closeApplyLeaveBtn = document.getElementById('closeApplyLeaveModalBtn');
      const cancelApplyLeaveBtn = document.getElementById('cancelApplyLeaveModalBtn');

      if (openApplyLeaveBtn && applyLeaveModal) {
        openApplyLeaveBtn.addEventListener('click', () => {
          applyLeaveModal.classList.remove('hidden');
        });
      }

      const closeApplyModal = () => {
        if (applyLeaveModal) {
          applyLeaveModal.classList.add('hidden');
        }
      };

      if (closeApplyLeaveBtn) closeApplyLeaveBtn.addEventListener('click', closeApplyModal);
      if (cancelApplyLeaveBtn) cancelApplyLeaveBtn.addEventListener('click', closeApplyModal);

      if (applyLeaveModal) {
        applyLeaveModal.addEventListener('click', (e) => {
          if (e.target === applyLeaveModal) {
            closeApplyModal();
          }
        });
      }
    </script>
  </body>
</html>
