<!-- CHANGE ROLE MODAL -->

<form action="/admin/changeRole/<%=user._id%>" method="post">
    <div
    class="fixed inset-0 z-50 hidden bg-inverse-surface/40 backdrop-blur-sm flex items-center justify-center p-stack-md"
    id="changeRoleModal"
>

    <div
        class="bg-surface-container-lowest rounded-xl max-w-md w-full p-stack-lg shadow-xl flex flex-col gap-stack-md"
    >

        <div class="flex items-center justify-between">

            <div class="flex items-center gap-2">

                <div
                    class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-on-surface"
                >

                    <span class="material-symbols-outlined text-[18px]">
                        admin_panel_settings
                    </span>

                </div>

                <h3 class="font-headline-md text-headline-md text-on-surface">
                    Change User Role
                </h3>

            </div>


            <button
                class="w-7 h-7 rounded-lg flex items-center justify-center text-on-surface-variant hover:bg-surface-container"
                id="closeChangeRoleBtn"
                type="button"
            >

                <span class="material-symbols-outlined text-[18px]">
                    close
                </span>

            </button>

        </div>


        <p class="font-body-md text-body-md text-on-surface-variant">

            Select the administrative permissions or access level for

            <strong class="text-on-surface">
                <%=user.fullname%>
            </strong>.

        </p>


        <div class="flex flex-col gap-2">


            <label
                class="flex items-center justify-between p-3 rounded-lg bg-surface-container-low cursor-pointer hover:bg-surface-container transition-colors"
            >

                <div class="flex flex-col">

                    <span class="font-label-md text-label-md text-on-surface">
                        Employee
                    </span>

                    <span class="font-label-sm text-label-sm text-on-surface-variant">
                        Standard view and personal leave requests
                    </span>

                </div>

                <input
                    <%= user.role === 'employee' ? 'checked' : '' %>
                    class="accent-primary w-4 h-4"
                    name="userRole"
                    type="radio"
                    value="employee"
                />

            </label>


            <label
                class="flex items-center justify-between p-3 rounded-lg bg-surface-container-lowest cursor-pointer hover:bg-surface-container transition-colors"
            >

                <div class="flex flex-col">

                    <span class="font-label-md text-label-md text-on-surface">
                        HR Manager
                    </span>

                    <span class="font-label-sm text-label-sm text-on-surface-variant">
                        Approve squad requests and view team schedule
                    </span>

                </div>

                <input
                    <%= user.role === 'hr' ? 'checked' : '' %>
                    class="accent-primary w-4 h-4"
                    name="userRole"
                    type="radio"
                    value="hr"
                />

            </label>


            <label
                class="flex items-center justify-between p-3 rounded-lg bg-surface-container-lowest cursor-pointer hover:bg-surface-container transition-colors"
            >

                <div class="flex flex-col">

                    <span class="font-label-md text-label-md text-on-surface">
                        Admin
                    </span>

                    <span class="font-label-sm text-label-sm text-on-surface-variant">
                        Full system permissions and employee management
                    </span>

                </div>

                <input
                    <%= user.role === 'admin' ? 'checked' : '' %>
                    class="accent-primary w-4 h-4"
                    name="userRole"
                    type="radio"
                    value="admin"
                />

            </label>

        </div>


        <div class="flex items-center justify-end gap-stack-sm pt-2">

            <button
                class="px-4 py-2 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-colors"
                id="cancelChangeRoleBtn"
                type="button"
            >
                Cancel
            </button>


            <button
                class="px-4 py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary/90 transition-colors"
                id="saveRoleBtn"
                type="submit"
            >
                Save Changes
            </button>

        </div>

    </div>

</div>
</form>



<!-- DELETE USER MODAL -->

<div
    class="fixed inset-0 z-50 hidden bg-inverse-surface/40 backdrop-blur-sm flex items-center justify-center p-stack-md"
    id="deleteUserModal"
>

    <div
        class="bg-surface-container-lowest rounded-xl max-w-md w-full p-stack-lg shadow-xl flex flex-col gap-stack-md"
    >

        <div class="flex items-center gap-3">

            <div
                class="w-10 h-10 rounded-full bg-error-container text-on-error-container flex items-center justify-center shrink-0"
            >

                <span class="material-symbols-outlined text-[20px]">
                    warning
                </span>

            </div>


            <div class="flex flex-col">

                <h3 class="font-headline-md text-headline-md text-on-surface">
                    Delete User Profile
                </h3>

                <span class="font-label-sm text-label-sm text-error">
                    Irreversible Action
                </span>

            </div>

        </div>


        <p class="font-body-md text-body-md text-on-surface-variant">

            Are you sure you want to permanently remove

            <strong class="text-on-surface">
                <%=user.fullname%> (<%=user.email%>)
            </strong>?

            This will delete all historic leave records, audit trails, and platform credentials.

        </p>


        <div class="flex items-center justify-end gap-stack-sm pt-2">

            <button
                class="px-4 py-2 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-colors"
                id="cancelDeleteBtn"
                type="button"
            >
                Keep User
            </button>


            <a  
                class="px-4 py-2 rounded-lg bg-error text-on-error font-label-md text-label-md hover:bg-error-container hover:text-on-error-container transition-colors"
                id="confirmDeleteBtn"
                href="/admin/users/delete/<%=user._id%>"
            >
                Yes, Delete Account
            </a>

        </div>

    </div>

</div>



<!-- LEAVE DETAIL MODAL -->

<div
    class="fixed inset-0 z-50 hidden bg-inverse-surface/40 backdrop-blur-sm flex items-center justify-center p-stack-md"
    id="leaveDetailModal"
>

    <div
        class="bg-surface-container-lowest rounded-xl max-w-lg w-full p-stack-lg shadow-xl flex flex-col gap-stack-md"
    >

        <div class="flex items-center justify-between">

            <div class="flex items-center gap-2">

                <span class="material-symbols-outlined text-secondary">
                    event_note
                </span>

                <h3
                    class="font-headline-md text-headline-md text-on-surface"
                    id="modalLeaveTitle"
                >
                    Leave Request Details
                </h3>

            </div>


            <button
                class="w-7 h-7 rounded-lg flex items-center justify-center text-on-surface-variant hover:bg-surface-container"
                id="closeDetailModalBtn"
                type="button"
            >

                <span class="material-symbols-outlined text-[18px]">
                    close
                </span>

            </button>

        </div>


        <div class="flex flex-col gap-3 py-2">


            <div
                class="flex items-center justify-between bg-surface-container-low p-3 rounded-lg"
            >

                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">
                    Dates
                </span>

                <span
                    class="font-label-md text-label-md text-on-surface"
                    id="modalLeaveDates"
                >
                    Sep 10 - Sep 12, 2026
                </span>

            </div>


            <div
                class="flex items-center justify-between bg-surface-container-low p-3 rounded-lg"
            >

                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">
                    Current Status
                </span>

                <span
                    class="font-label-md text-label-md text-secondary"
                    id="modalLeaveStatus"
                >
                    Approved
                </span>

            </div>


            <div
                class="flex flex-col gap-1 bg-surface-container-low p-3 rounded-lg"
            >

                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">
                    Reason Stated
                </span>

                <p
                    class="font-body-md text-body-md text-on-surface"
                    id="modalLeaveReason"
                >
                    Family trip to northern areas
                </p>

            </div>

        </div>


        <div class="flex items-center justify-end pt-2">

            <button
                class="px-4 py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary/90 transition-colors"
                id="closeDetailActionBtn"
                type="button"
            >
                Close Record
            </button>

        </div>

    </div>

</div>



<!-- JAVASCRIPT -->

<script>

    // Interactive Handlers for Modals

    const roleModal = document.getElementById('changeRoleModal');

    const deleteModal = document.getElementById('deleteUserModal');

    const detailModal = document.getElementById('leaveDetailModal');


    // Change Role Modal Handlers

    document.getElementById('openChangeRoleBtn')?.addEventListener('click', () => {
      roleModal?.classList.remove('hidden');
    });


    const closeRole = () => roleModal?.classList.add('hidden');


    document.getElementById('closeChangeRoleBtn')?.addEventListener('click', closeRole);

    document.getElementById('cancelChangeRoleBtn')?.addEventListener('click', closeRole);


    document.getElementById('saveRoleBtn')?.addEventListener('click', () => {

      const selected = document.querySelector('input[name="userRole"]:checked');

      if (selected) {
        alert('Role updated to ' + selected.value + ' for <%=user.fullname%>.');
      }

      closeRole();

    });


    // Delete Modal Handlers

    document.getElementById('openDeleteUserBtn')?.addEventListener('click', () => {
      deleteModal?.classList.remove('hidden');
    });


    const closeDelete = () => deleteModal?.classList.add('hidden');


    document.getElementById('cancelDeleteBtn')?.addEventListener('click', closeDelete);


    document.getElementById('confirmDeleteBtn')?.addEventListener('click', () => {

      alert('User <%=user.fullname%> has been queued for deletion.');

      closeDelete();

    });


    // Leave Detail Handlers

    document.querySelectorAll('.leave-detail-btn').forEach(btn => {

      btn.addEventListener('click', (e) => {

        const target = e.currentTarget;

        const title = target.getAttribute('data-title');

        const reason = target.getAttribute('data-reason');

        const dates = target.getAttribute('data-dates');

        const status = target.getAttribute('data-status');


        document.getElementById('modalLeaveTitle').textContent =
          title + ' Details';

        document.getElementById('modalLeaveDates').textContent =
          dates;

        document.getElementById('modalLeaveStatus').textContent =
          status;

        document.getElementById('modalLeaveReason').textContent =
          reason;


        detailModal?.classList.remove('hidden');

      });

    });


    const closeDetails = () => detailModal?.classList.add('hidden');


    document.getElementById('closeDetailModalBtn')?.addEventListener(
      'click',
      closeDetails
    );


    document.getElementById('closeDetailActionBtn')?.addEventListener(
      'click',
      closeDetails
    );

</script>

</body>
</html>