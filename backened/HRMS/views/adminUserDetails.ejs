<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>

  <style>
    @layer base {
      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        overscroll-behavior: none;
      }

      main > :first-child {
        margin-top: 0 !important;
      }

      main > :last-child {
        margin-bottom: 0 !important;
      }
    }

    ::-webkit-scrollbar {
      display: none;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>

  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-primary": "#ffffff",
            "secondary": "#0058be",
            "inverse-surface": "#2f3038",
            "on-secondary": "#ffffff",
            "error": "#ba1a1a",
            "background": "#fbf8ff",
            "on-primary-fixed-variant": "#474649",
            "on-error": "#ffffff",
            "on-secondary-container": "#fefcff",
            "tertiary-fixed-dim": "#cec4c4",
            "on-tertiary-fixed-variant": "#4c4545",
            "on-tertiary": "#ffffff",
            "surface-container-lowest": "#ffffff",
            "secondary-fixed": "#d8e2ff",
            "error-container": "#ffdad6",
            "surface-tint": "#5f5e60",
            "on-primary-fixed": "#1c1b1d",
            "surface-container-high": "#e8e7f1",
            "inverse-primary": "#c8c6c8",
            "surface-container-low": "#f4f2fd",
            "on-error-container": "#93000a",
            "tertiary": "#000000",
            "surface-container": "#eeedf7",
            "on-tertiary-fixed": "#1f1a1a",
            "primary-container": "#1c1b1d",
            "tertiary-container": "#1f1a1a",
            "outline": "#78767b",
            "primary": "#000000",
            "primary-fixed-dim": "#c8c6c8",
            "surface-variant": "#e3e1ec",
            "secondary-container": "#2170e4",
            "surface-bright": "#fbf8ff",
            "on-secondary-fixed": "#001a42",
            "inverse-on-surface": "#f1effa",
            "on-secondary-fixed-variant": "#004395",
            "surface": "#fbf8ff",
            "secondary-fixed-dim": "#adc6ff",
            "on-background": "#1a1b22",
            "on-primary-container": "#858386",
            "primary-fixed": "#e5e1e4",
            "on-surface": "#1a1b22",
            "on-surface-variant": "#47464a",
            "on-tertiary-container": "#8a8282",
            "outline-variant": "#c8c5ca",
            "surface-container-highest": "#e3e1ec",
            "tertiary-fixed": "#ebe0df",
            "surface-dim": "#dad9e3"
          },

          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },

          spacing: {
            "stack-md": "1rem",
            "gutter": "1.5rem",
            "stack-lg": "2rem",
            "stack-sm": "0.5rem",
            "container-max": "1440px",
            "margin-page": "2rem"
          },

          fontFamily: {
            "label-sm": ["Geist"],
            "body-lg": ["Geist"],
            "headline-lg": ["Geist"],
            "label-md": ["Geist"],
            "headline-md": ["Geist"],
            "body-md": ["Geist"],
            "headline-xl": ["Geist"]
          },

          fontSize: {
            "label-sm": [
              "11px",
              {
                lineHeight: "14px",
                fontWeight: "600"
              }
            ],

            "body-lg": [
              "16px",
              {
                lineHeight: "24px",
                fontWeight: "400"
              }
            ],

            "headline-lg": [
              "24px",
              {
                lineHeight: "32px",
                letterSpacing: "-0.01em",
                fontWeight: "600"
              }
            ],

            "label-md": [
              "12px",
              {
                lineHeight: "16px",
                letterSpacing: "0.01em",
                fontWeight: "500"
              }
            ],

            "headline-md": [
              "18px",
              {
                lineHeight: "28px",
                fontWeight: "600"
              }
            ],

            "body-md": [
              "14px",
              {
                lineHeight: "20px",
                fontWeight: "400"
              }
            ],

            "headline-xl": [
              "36px",
              {
                lineHeight: "44px",
                letterSpacing: "-0.02em",
                fontWeight: "600"
              }
            ]
          }
        }
      }
    };
  </script>
</head>


<body class="bg-surface font-body-md text-body-md text-on-surface">


  <!-- SIDEBAR -->

  <aside
    class="fixed left-0 top-0 h-full w-60 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex flex-col justify-between py-stack-md"
  >

    <div class="flex flex-col">

      <div class="px-gutter h-14 flex items-center gap-stack-sm">

        <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center">

          <span class="material-symbols-outlined text-on-primary text-[18px]">
            corporate_fare
          </span>

        </div>

        <div class="flex flex-col">

          <span class="font-headline-md text-headline-md leading-none text-on-surface">
            MINI HRMS
          </span>

          <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
            Admin Workspace
          </span>

        </div>

      </div>


      <div class="px-gutter mt-stack-md mb-stack-sm">

        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
          Platform
        </span>

      </div>


      <nav
        class="flex flex-col gap-1 px-3"
        data-active-classes="bg-surface-container text-on-surface font-headline-md"
      >

        <a
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors"
          data-path="dashboard"
          href="#"
        >

          <span class="material-symbols-outlined text-[20px]">
            dashboard
          </span>

          <span class="font-body-md text-body-md">
            Dashboard
          </span>

        </a>


        <a
          aria-current="page"
          class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors bg-surface-container text-on-surface font-headline-md"
          data-path="users"
          href="#"
        >

          <span class="material-symbols-outlined text-[20px]">
            group
          </span>

          <span class="font-body-md text-body-md">
            Users
          </span>

        </a>


        <a
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors"
          data-path="my-profile"
          href="#"
        >

          <span class="material-symbols-outlined text-[20px]">
            badge
          </span>

          <span class="font-body-md text-body-md">
            My Profile
          </span>

        </a>


        <a
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors"
          data-path="settings"
          href="#"
        >

          <span class="material-symbols-outlined text-[20px]">
            settings
          </span>

          <span class="font-body-md text-body-md">
            Settings
          </span>

        </a>

      </nav>

    </div>


    <div class="px-3 pt-stack-md flex flex-col gap-1">

      <a
        class="flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant hover:bg-error-container hover:text-on-error-container transition-colors"
        data-path="login"
        href="#"
      >

        <span class="material-symbols-outlined text-[20px]">
          logout
        </span>

        <span class="font-body-md text-body-md">
          Logout
        </span>

      </a>

    </div>

  </aside>



  <!-- MAIN -->

  <div class="pl-60 min-h-screen flex flex-col">


    <!-- HEADER -->

    <header
      class="fixed top-0 left-60 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 px-gutter flex items-center justify-between"
    >

      <div class="flex items-center w-80">

        <div
          class="flex items-center w-full px-3 py-1.5 rounded-lg bg-surface-container-low text-on-surface-variant gap-2"
        >

          <span class="material-symbols-outlined text-[18px]">
            search
          </span>

          <input
            class="w-full bg-transparent border-none outline-none font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant"
            placeholder="Search employees, teams, records..."
            type="text"
          />

        </div>

      </div>


      <div class="flex items-center gap-stack-md">

        <button
          class="w-9 h-9 rounded-lg flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors relative"
          type="button"
        >

          <span class="material-symbols-outlined text-[20px]">
            notifications
          </span>

          <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-error"></span>

        </button>


        <div class="flex items-center gap-stack-sm pl-2">

          <div class="flex flex-col items-end">

            <span class="font-label-md text-label-md text-on-surface leading-tight">
              Admin User
            </span>

            <span class="font-label-sm text-label-sm text-on-surface-variant">
              HR Operations
            </span>

          </div>


          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">

            <span class="material-symbols-outlined text-on-primary text-[18px]">
              person
            </span>

          </div>

        </div>

      </div>

    </header>



    <!-- CONTENT -->

    <main class="w-full pt-16 bg-surface flex-1">

      <div class="flex flex-col w-full">

        <div
          class="w-full max-w-[1440px] mx-auto px-margin-page py-stack-lg flex flex-col gap-stack-lg"
        >


          <!-- BREADCRUMB -->

          <div class="flex items-center justify-between">

            <a
              class="group inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors"
              data-path="users"
              href="#"
            >

              <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-0.5 transition-transform">
                arrow_back
              </span>

              <span class="font-label-md text-label-md">
                Back to Users
              </span>

            </a>


            <div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm">

              <span>
                HR Management
              </span>

              <span>/</span>

              <span>
                Directory
              </span>

              <span>/</span>

              <span class="text-on-surface">
                USR-84920
              </span>

            </div>

          </div>



          <!-- USER PROFILE HEADER -->

          <div
            class="bg-surface-container-lowest rounded-xl p-stack-lg shadow-sm flex flex-col lg:flex-row items-start lg:items-center justify-between gap-stack-md"
          >

            <div class="flex items-center gap-stack-md min-w-0">


              <!-- AVATAR -->

              <div class="relative shrink-0">

                <div
                  class="w-16 h-16 rounded-full bg-surface-container-high overflow-hidden flex items-center justify-center text-on-surface font-headline-md text-headline-md"
                >

                  <img
                    class="w-full h-full object-cover"
                    data-alt="High-resolution professional headshot of Ali Khan, a Pakistani male corporate software engineer wearing a dark tailored shirt in a minimally lit studio setting with neutral gray background and clean rim lighting."
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBTcB9JjoZSn8-DVGh3ditlSsFO6F0RMPu90o3EJ9NI0WRYX_4GgYGP_Mo2dRdXqrtdHb-HSSFWpsAQ8cpiizrRSMo2wMycjDfJ8Hy05MKw3d53Kps9Q1eZvKQRtirlQGjAVrCj_IZNC6U1_ZGvff2yA46r0fP3yMTI5LnXnQMRYp-8RcmFnx3hQeEqfcPjpsuF68pZq6iEp81oRILNB2DsBGTP3mKGNKcqPpTe7a_qKKq62CXx3Egk"
                  />

                </div>


                <span
                  class="absolute bottom-0.5 right-0.5 w-3.5 h-3.5 rounded-full bg-secondary ring-2 ring-surface-container-lowest"
                  title="Active Status"
                ></span>

              </div>



              <!-- META DETAILS -->

              <div class="flex flex-col min-w-0">

                <div class="flex items-center gap-2.5 flex-wrap">

                  <h1
                    class="font-headline-lg text-headline-lg text-on-surface tracking-tight truncate"
                  >
                  <%=user.fullname%>
                  </h1>


                  <!-- <span
                    class="px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1"
                  >

                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>

                    Full-time

                  </span> -->

                </div>


                <div class="flex items-center gap-stack-sm flex-wrap mt-0.5">

                  <span class="font-body-md text-body-md text-on-surface-variant">
                    <%=user.email%>
                  </span>

                  <span class="text-on-surface-variant">
                    ·
                  </span>

                  <span class="font-label-md text-label-md text-on-surface-variant">
                    <%=user.role%>
                  </span>

                  <span class="text-on-surface-variant">
                    ·
                  </span>

                  <span class="font-label-sm text-label-sm text-on-surface-variant">
                    Joined <%=user.createdAt.toDateString()%>
                  </span>

                </div>

              </div>

            </div>



            <!-- ACTION BUTTONS -->

            <div
              class="flex items-center gap-stack-sm w-full lg:w-auto justify-end pt-stack-sm lg:pt-0"
            >

              <button
                class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md transition-colors"
                id="openChangeRoleBtn"
                type="button"
              >

                <span class="material-symbols-outlined text-[18px]">
                  admin_panel_settings
                </span>

                <span>
                  Change Role
                </span>

              </button>


              <button
                class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-error text-on-error hover:bg-error-container hover:text-on-error-container font-label-md text-label-md transition-colors"
                id="openDeleteUserBtn"
                type="button"
              >

                <span class="material-symbols-outlined text-[18px]">
                  delete
                </span>

                <span>
                  Delete User
                </span>

              </button>

            </div>

          </div>



          <!-- STATISTICS -->

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">


            <!-- TOTAL LEAVES -->

            <div
              class="bg-surface-container-lowest rounded-xl p-stack-md shadow-sm flex flex-col justify-between"
            >

              <div class="flex items-center justify-between">

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Total Leaves
                </span>

                <div
                  class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-on-surface"
                >

                  <span class="material-symbols-outlined text-[18px]">
                    date_range
                  </span>

                </div>

              </div>


              <div class="mt-4 flex items-baseline justify-between">

                <span class="font-headline-xl text-headline-xl text-on-surface font-headline-lg">
                    <%=user.leaves.totalLeaves.length%>
                </span>

                <span class="font-label-sm text-label-sm text-on-surface-variant">
                  Allocated: 24
                </span>

              </div>

            </div>



            <!-- APPROVED -->

            <div
              class="bg-surface-container-lowest rounded-xl p-stack-md shadow-sm flex flex-col justify-between"
            >

              <div class="flex items-center justify-between">

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Approved
                </span>

                <div
                  class="w-8 h-8 rounded-lg bg-surface-container-low flex items-center justify-center text-secondary"
                >

                  <span class="material-symbols-outlined text-[18px]">
                    check_circle
                  </span>

                </div>

              </div>


              <div class="mt-4 flex items-baseline justify-between">

                <span class="font-headline-xl text-headline-xl text-on-surface font-headline-lg">
                  <%=user.leaves.approvedLeaves.length%>
                </span>

                <span
                  class="px-2 py-0.5 rounded-full bg-surface-container-low text-secondary font-label-sm text-label-sm"
                >
                  58.3%
                </span>

              </div>

            </div>



            <!-- PENDING -->

            <div
              class="bg-surface-container-lowest rounded-xl p-stack-md shadow-sm flex flex-col justify-between"
            >

              <div class="flex items-center justify-between">

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Pending
                </span>

                <div
                  class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-on-surface"
                >

                  <span class="material-symbols-outlined text-[18px]">
                    pending_actions
                  </span>

                </div>

              </div>


              <div class="mt-4 flex items-baseline justify-between">

                <span class="font-headline-xl text-headline-xl text-on-surface font-headline-lg">
                     <%=user.leaves.totalLeaves.length%>

                </span>

                <span
                  class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm"
                >
                  In review
                </span>

              </div>

            </div>



            <!-- REJECTED -->

            <div
              class="bg-surface-container-lowest rounded-xl p-stack-md shadow-sm flex flex-col justify-between"
            >

              <div class="flex items-center justify-between">

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Rejected
                </span>

                <div
                  class="w-8 h-8 rounded-lg bg-error-container flex items-center justify-center text-on-error-container"
                >

                  <span class="material-symbols-outlined text-[18px]">
                    cancel
                  </span>

                </div>

              </div>


              <div class="mt-4 flex items-baseline justify-between">

                <span class="font-headline-xl text-headline-xl text-on-surface font-headline-lg">
                     <%=user.leaves.rejectedLeaves.length%>

                </span>

                <span
                  class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm"
                >
                  16.6%
                </span>

              </div>

            </div>

          </div>



          <!-- PERSONAL INFORMATION -->

          <div
            class="bg-surface-container-lowest rounded-xl p-stack-lg shadow-sm"
          >

            <div class="flex items-center justify-between pb-stack-md">

              <div>

                <h2 class="font-headline-md text-headline-md text-on-surface">
                  Personal Information
                </h2>

                <p class="font-body-md text-body-md text-on-surface-variant mt-0.5">
                  Employee contact and organizational records.
                </p>

              </div>


              <button
                class="inline-flex items-center gap-1 text-secondary hover:text-on-surface font-label-md text-label-md transition-colors"
                type="button"
              >

                <span class="material-symbols-outlined text-[16px]">
                  edit
                </span>

                <span>
                  Edit Details
                </span>

              </button>

            </div>



            <!-- KEY VALUE GRID -->

            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 pt-stack-sm"
            >

              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Full Name
                </span>

                <span class="font-body-md text-body-md text-on-surface font-headline-md">
                  <%=user.fullname%>
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Email
                </span>

                <span class="font-body-md text-body-md text-on-surface">
                  <%=user.email%>
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Phone
                </span>

                <span class="font-body-md text-body-md text-on-surface">
                 <%=user.phone%>
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Address
                </span>

                <span class="font-body-md text-body-md text-on-surface">
                  <%=user.address%>
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  <%=user.role%>
                </span>

                <span
                  class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm"
                >
                  Employee
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Joined
                </span>

                <span class="font-body-md text-body-md text-on-surface">
                  <%=user.createdAt.toDateString()%>
                </span>

              </div>


              <div
                class="flex items-center justify-between py-2 bg-surface-container-lowest hover:bg-surface-container-low px-3 rounded-lg transition-colors md:col-span-2"
              >

                <span class="font-label-md text-label-md text-on-surface-variant">
                  Last Updated
                </span>

                <span class="font-body-md text-body-md text-on-surface-variant">
                  2 days ago
                </span>

              </div>

            </div>

          </div>



          <!-- LEAVE HISTORY -->

          <div
            class="bg-surface-container-lowest rounded-xl shadow-sm flex flex-col overflow-hidden"
          >


            <!-- SECTION HEADER -->

            <div
              class="p-stack-lg flex flex-col sm:flex-row sm:items-center justify-between gap-stack-sm"
            >

              <div>

                <h2 class="font-headline-md text-headline-md text-on-surface">
                  Leave History
                </h2>

                <p class="font-body-md text-body-md text-on-surface-variant mt-0.5">
                  All recorded time off requests for this user.
                </p>

              </div>


              <div class="flex items-center gap-stack-sm">

                <div
