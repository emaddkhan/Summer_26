<!DOCTYPE html>

<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>

<title>Admin Dashboard - MINI HRMS</title>

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet"/>

<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>

<script id="tailwind-config">
tailwind.config = {
    darkMode: "class",

    theme: {
        extend: {

            colors: {
                "surface-bright": "#fbf8ff",
                "surface-container-lowest": "#ffffff",
                "secondary-fixed-dim": "#adc6ff",
                "on-tertiary": "#ffffff",
                "surface-container-highest": "#e3e1ec",
                "tertiary-fixed": "#ebe0df",
                "secondary": "#0058be",
                "on-secondary-container": "#fefcff",
                "on-secondary-fixed-variant": "#004395",
                "secondary-container": "#2170e4",
                "secondary-fixed": "#d8e2ff",
                "surface-variant": "#e3e1ec",
                "primary": "#000000",
                "error-container": "#ffdad6",
                "error": "#ba1a1a",
                "surface-container": "#eeedf7",
                "primary-fixed-dim": "#c8c6c8",
                "on-tertiary-fixed-variant": "#4c4545",
                "primary-container": "#1c1b1d",
                "surface-container-high": "#e8e7f1",
                "inverse-primary": "#c8c6c8",
                "surface-dim": "#dad9e3",
                "on-secondary": "#ffffff",
                "tertiary-container": "#1f1a1a",
                "background": "#fbf8ff",
                "on-error-container": "#93000a",
                "on-tertiary-fixed": "#1f1a1a",
                "tertiary": "#000000",
                "outline": "#78767b",
                "on-primary": "#ffffff",
                "on-background": "#1a1b22",
                "on-secondary-fixed": "#001a42",
                "on-error": "#ffffff",
                "on-primary-fixed": "#1c1b1d",
                "on-surface-variant": "#47464a",
                "on-tertiary-container": "#8a8282",
                "on-surface": "#1a1b22",
                "on-primary-fixed-variant": "#474649",
                "tertiary-fixed-dim": "#cec4c4",
                "inverse-surface": "#2f3038",
                "inverse-on-surface": "#f1effa",
                "surface": "#fbf8ff",
                "outline-variant": "#c8c5ca",
                "surface-tint": "#5f5e60",
                "surface-container-low": "#f4f2fd",
                "primary-fixed": "#e5e1e4",
                "on-primary-container": "#858386"
            },

            borderRadius: {
                DEFAULT: "0.25rem",
                lg: "0.5rem",
                xl: "0.75rem",
                full: "9999px"
            },

            spacing: {
                "stack-md": "1rem",
                "margin-page": "2rem",
                "container-max": "1440px",
                "stack-sm": "0.5rem",
                "gutter": "1.5rem",
                "stack-lg": "2rem"
            },

            fontFamily: {
                "label-sm": ["Geist"],
                "headline-lg": ["Geist"],
                "headline-md": ["Geist"],
                "body-lg": ["Geist"],
                "label-md": ["Geist"],
                "headline-xl": ["Geist"],
                "body-md": ["Geist"]
            },

            fontSize: {
                "label-sm": [
                    "11px",
                    {
                        lineHeight: "14px",
                        fontWeight: "600"
                    }
                ],

                "headline-lg": [
                    "24px",
                    {
                        lineHeight: "32px",
                        letterSpacing: "-0.01em",
                        fontWeight: "600"
                    }
                ],

                "headline-md": [
                    "18px",
                    {
                        lineHeight: "28px",
                        fontWeight: "600"
                    }
                ],

                "body-lg": [
                    "16px",
                    {
                        lineHeight: "24px",
                        fontWeight: "400"
                    }
                ],

                "label-md": [
                    "12px",
                    {
                        lineHeight: "16px",
                        letterSpacing: "0.01em",
                        fontWeight: "500"
                    }
                ],

                "headline-xl": [
                    "36px",
                    {
                        lineHeight: "44px",
                        letterSpacing: "-0.02em",
                        fontWeight: "600"
                    }
                ],

                "body-md": [
                    "14px",
                    {
                        lineHeight: "20px",
                        fontWeight: "400"
                    }
                ]
            }
        }
    }
}
</script>

<style>
body {
    font-family: 'Geist', sans-serif;
}
</style>

</head>

<body class="bg-surface text-on-surface h-screen overflow-hidden flex">

<%- include('partials/flashToast') %>

<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<!-- Main Content Wrapper -->

<div class="flex-1 ml-60 flex flex-col h-screen overflow-hidden">

<!-- TopAppBar -->

<header class="flex justify-between items-center h-16 px-gutter bg-surface-bright dark:bg-surface-dim border-b border-outline-variant dark:border-outline shrink-0 z-10">

    <div class="flex items-center gap-4">

        <div class="relative focus-within:ring-2 focus-within:ring-outline-variant rounded-full transition-all duration-200 ease-in-out">

            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">
                search
            </span>

            <input
                class="pl-9 pr-4 py-1.5 bg-surface-container-lowest border border-outline-variant rounded-full text-body-md font-body-md text-on-surface placeholder-outline focus:outline-none w-64"
                placeholder="Search..."
                type="text"
            />

        </div>

    </div>


    <div class="flex items-center gap-4">

        <button class="p-2 rounded-full text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">

            <span class="material-symbols-outlined">
                notifications
            </span>

        </button>

        <div class="w-8 h-8 rounded-full overflow-hidden border border-outline-variant">

            <img
                alt="User avatar"
                class="w-full h-full object-cover"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBKG226xoBqBxQ6uXdC8HDb6OZzq0Ml8Q0iiTPD4v7Hkc5MDC7oAxlU5tp5QS1h-hEZURRE98FmZ9m1PybhFzqiWETWl9XnSM4Ui0HnkwySwDCT9vPT0RKtqVOcfZwatqUP5HrpTqVLWYKrFm47otp2nem8iWOzR-XV3YU33FaQnrSk1BJntt3lVVBjIs_xoNjBaL79xvE0PaLGL0iMmKpdt155ZehysHWbd9iP_lz_uh4UpK9fOsm"
            />

        </div>

    </div>

</header>


<!-- Main Scrollable Content -->

<main class="flex-1 overflow-y-auto p-margin-page">

    <div class="max-w-[1440px] mx-auto">

        <header class="mb-8">

            <h2 class="text-headline-xl font-headline-xl text-primary">
                Admin Dashboard
            </h2>

        </header>


        <!-- Stats Grid -->

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-8">


            <!-- Total Users -->

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:border-outline transition-colors">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">
                        Total Users
                    </h3>

                    <span class="material-symbols-outlined text-outline">
                        group
                    </span>

                </div>

                <div class="text-headline-xl font-headline-xl text-primary">
                    <%=userLength%>
                </div>

            </div>


            <!-- HR Managers -->

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:border-outline transition-colors">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">
                        HR Managers
                    </h3>

                    <span class="material-symbols-outlined text-secondary">
                        manage_accounts
                    </span>

                </div>

                <div class="text-headline-xl font-headline-xl text-primary">
                    <%=hrLength%>
                </div>

            </div>


            <!-- Employees -->

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:border-outline transition-colors">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">
                        Employees
                    </h3>

                    <span class="material-symbols-outlined text-outline">
                        badge
                    </span>

                </div>

                <div class="text-headline-xl font-headline-xl text-primary">
                    <%=employeeLength%>
                </div>

            </div>


            <!-- Admins -->

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:border-outline transition-colors">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">
                        Admins
                    </h3>

                    <span class="material-symbols-outlined text-primary">
                        admin_panel_settings
                    </span>

                </div>

                <div class="text-headline-xl font-headline-xl text-primary">
                    <%=adminLength%>
                </div>

            </div>

        </div>


        <!-- Recent Users Section -->

        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden">

            <div class="p-6 border-b border-outline-variant flex justify-between items-center bg-surface-bright">

                <h3 class="text-headline-md font-headline-md text-primary">
                    Users
                </h3>

                <!-- <button class="text-label-sm font-label-sm text-secondary hover:text-primary transition-colors">
                    View All
                </button> -->

            </div>


            <div class="overflow-x-auto">

                <table class="w-full text-left border-collapse">

                    <thead>

                        <tr class="bg-surface-bright border-b border-outline-variant">

                            <th class="px-6 py-4 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider w-16">
                                Profile
                            </th>

                            <th class="px-6 py-4 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">
                                Name
                            </th>

                            <th class="px-6 py-4 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">
                                Email
                            </th>

                            <th class="px-6 py-4 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">
                                Role
                            </th>

                            <th class="px-6 py-4 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider text-right">
                                Joined Date
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-outline-variant">
                        <% users.forEach(function(user) { %>
                             <tr class="hover:bg-surface-container-low transition-colors group">

                            <td class="px-6 py-4">

                                
                                    <div class="w-10 h-10 rounded-full bg-surface-container-high border border-outline-variant overflow-hidden">

                                    <img
                                        class="w-full h-full object-cover"
                                        src="data:<%=user.imageType%>;base64,<%=user.profileImage.toString('base64')%>"
                                    />

                                </div>

                            </td>

                            <td class="px-6 py-4 text-body-md font-body-md font-medium text-primary">
                               <a href="/admin/user/<%=user.id%>"><%=user.fullname%></a>
                            </td>

                            <td class="px-6 py-4 text-body-md font-body-md text-on-surface-variant">
                                <%=user.email%>
                            </td>

                            <td class="px-6 py-4">
                                <%if(user.role === "admin") {%>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-primary text-on-primary">
                                    Admin
                                </span>
                                <% }else if(user.role === "employee") {%>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-secondary text-on-secondary">
                                    Employee
                                </span>
                                <% }else if(user.role === "hr") {%>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary text-on-tertiary">
                                    HR Manager
                                </span>
                                <% } %>
                            </td>

                            <td class="px-6 py-4 text-body-md font-body-md text-on-surface-variant text-right">
                                <%=user.createdAt.toDateString()%>
                            </td>

                        </tr>
                        <%})%>

                       


