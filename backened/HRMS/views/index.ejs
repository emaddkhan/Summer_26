<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HRMS login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full text-black flex min-h-screen bg-zinc-800">
      <div class="h-screen flex justify-center items-center w-1/2 bg-[#EDECF6]">
        <div class="flex flex-col gap-4 justify-center w-1/2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            id="Corporate-Fare--Streamline-Sharp-Material"
            height="40"
            width="40"
          >
            <desc>
              Corporate Fare Streamline Icon: https://streamlinehq.com
            </desc>
            <path
              fill="#000000"
              d="M2 21V3h9.75v4.125H22V21H2Zm1.5 -1.5h6.75v-2.625H3.5V19.5Zm0 -4.125h6.75V12.75H3.5v2.625Zm0 -4.125h6.75v-2.625H3.5v2.625Zm0 -4.125h6.75V4.5H3.5v2.625ZM11.75 19.5H20.5V8.625H11.75V19.5Zm2 -6.75v-1.5h4.125v1.5H13.75Zm0 4.125v-1.5h4.125v1.5H13.75Z"
              stroke-width="0.5"
            ></path>
          </svg>
          <h1 class="text-3xl font-bold">MINI HRMS</h1>
          <p class="font-semibold text-[#47464A] leading-5">
            Streamline your organization's workforce management with precision
            and clarity. A high-end, minimal approach to professional HR data.
          </p>
          <div class="p-4 mt-4 bg-white rounded-lg w-full">
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                height="24"
                width="24"
              >
                <g id="Security">
                  <path
                    id="Union"
                    fill="#000000"
                    d="M11.7236 2.03903c0.2106 -0.06056 0.4361 -0.05039 0.6416 0.03028l7 2.75 0.1377 0.0664c0.3044 0.17705 0.4971 0.5046 0.4971 0.86426V11.25c-0.0001 4.903 -3.0925 9.1031 -7.6719 10.6943 -0.2125 0.0739 -0.4437 0.0739 -0.6562 0C7.09253 20.3531 4.00006 16.153 4 11.25V5.74997l0.01172 -0.15234c0.05354 -0.34795 0.28838 -0.64683 0.62305 -0.77832l7.00003 -2.75zM6 6.43064V11.25c0 0.2524 0.00973 0.5025 0.0293 0.75H12v7.9346c3.3817 -1.3106 5.6872 -4.3474 5.9707 -7.9346H12V4.07321z"
                    stroke-width="1"
                  ></path>
                </g>
              </svg>
              <h3 class="font-bold">Enterprise Security</h3>
            </div>
            <p class="text-sm font-semibold text-[#47464A]">
              Your employee data is protected by industry-leading encryption and strict access controls.
            </p>
          </div>
        </div>
      </div>
      <div
        class="h-screen flex justify-center items-center w-1/2 bg-[#FBF8FF]"
      >
      <div class="w-1/2 flex-col justify-center flex gap-2">
        <h3 class="text-2xl font-bold">Sign in to your account</h3>
        <p class="text-sm font-semibold text-[#47464A]">
          Enter your credentials to access the management portal
        </p>
        <form action="/login" method="POST" class="flex flex-col gap-1 mt-4">
          <label class="font-semibold text-sm " for="email">Email address</label>
          <input
            type="text"
            name="email"
            placeholder="name@company.com"
            class="p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-1 focus:ring-black-500"
          />
          <label class="font-semibold text-sm mt-4 " for="password">Password</label>
          <input
            type="password"
            name="password"
            placeholder="Password"
            class="p-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-1 focus:ring-black-500"
          />
          <button
            type="submit"
            class="bg-black cursor-pointer text-white p-2 mt-6 rounded-lg hover:bg-[#1C1B1D] transition duration-200"
          >
            Sign In
          </button>
        </form>
        <p class="text-sm text-center font-semibold text-[#47464A] mt-2">
          Don't have an account? <a href="/register" class="text-black underline">Request Access</a>
        </p>
      </div>
    </div>
    </div>
  </body>
</html>
