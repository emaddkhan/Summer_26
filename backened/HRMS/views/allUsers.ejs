<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>User Directory - Admin Portal - MINI HRMS</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-bright": "#fbf8ff",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#adc6ff",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#e3e1ec",
                        "secondary": "#0058be",
                        "secondary-container": "#2170e4",
                        "surface-variant": "#e3e1ec",
                        "primary": "#000000",
                        "error-container": "#ffdad6",
                        "error": "#ba1a1a",
                        "surface-container": "#eeedf7",
                        "primary-container": "#1c1b1d",
                        "surface-container-high": "#e8e7f1",
                        "surface-dim": "#dad9e3",
                        "on-secondary": "#ffffff",
                        "background": "#fbf8ff",
                        "on-error-container": "#93000a",
                        "tertiary": "#000000",
                        "outline": "#78767b",
                        "on-primary": "#ffffff",
                        "on-background": "#1a1b22",
                        "on-surface-variant": "#47464a",
                        "on-surface": "#1a1b22",
                        "surface": "#fbf8ff",
                        "outline-variant": "#c8c5ca",
                        "surface-container-low": "#f4f2fd"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "stack-md": "1rem",
                        "margin-page": "2rem",
                        "container-max": "1440px",
                        "stack-sm": "0.5rem",
                        "gutter": "1.5rem",
                        "stack-lg": "2rem"
                    },
                    fontFamily: {
                        "body-md": ["Geist"],
                        "label-md": ["Geist"],
                        "headline-xl": ["Geist"],
                        "headline-md": ["Geist"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Geist', sans-serif; }
        ::-webkit-scrollbar { display: none; }
    </style>
</head>

<body class="bg-surface text-on-surface h-screen overflow-hidden flex">

<!-- SUCCESS & ERROR FLASH TOAST POPUPS -->
<% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length > 0) { %>
  <div id="flash-toast-container" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-md px-4 pointer-events-none transition-all duration-300">
    <div class="pointer-events-auto flex items-center justify-between gap-3 p-3.5 bg-emerald-950/90 text-emerald-100 border border-emerald-500/30 rounded-xl shadow-2xl backdrop-blur-md">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[20px]">check_circle</span>
        </div>
        <div>
          <h4 class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Success</h4>
          <p class="text-sm font-medium text-emerald-100 mt-0.5"><%= Array.isArray(successMessage) ? successMessage[0] : successMessage %></p>
        </div>
      </div>
      <button onclick="this.closest('#flash-toast-container').remove()" class="text-emerald-400/70 hover:text-emerald-100 p-1.5 rounded-lg transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>
  </div>
  <script>setTimeout(() => { document.getElementById('flash-toast-container')?.remove(); }, 4500);</script>
<% } %>

<% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length > 0) { %>
  <div id="flash-toast-err-container" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-md px-4 pointer-events-none transition-all duration-300">
    <div class="pointer-events-auto flex items-center justify-between gap-3 p-3.5 bg-rose-950/90 text-rose-100 border border-rose-500/30 rounded-xl shadow-2xl backdrop-blur-md">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[20px]">error</span>
        </div>
        <div>
          <h4 class="text-[11px] font-bold text-rose-400 uppercase tracking-wider">Error</h4>
          <p class="text-sm font-medium text-rose-100 mt-0.5"><%= Array.isArray(errorMessage) ? errorMessage[0] : errorMessage %></p>
        </div>
      </div>
      <button onclick="this.closest('#flash-toast-err-container').remove()" class="text-rose-400/70 hover:text-rose-100 p-1.5 rounded-lg transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>
  </div>
  <script>setTimeout(() => { document.getElementById('flash-toast-err-container')?.remove(); }, 4500);</script>
<% } %>

<%- include('partials/sidebar', { activePage: 'users' }) %>

<!-- Dynamic Users Setup -->
<%
let displayUsers = (typeof users !== 'undefined' && users && users.length > 0)
    ? users
    : ((typeof allStaff !== 'undefined' && allStaff && allStaff.length > 0) ? allStaff : []);

let totalUserCount = displayUsers.length;
let empCount = displayUsers.filter(u => u.role === 'employee').length;
let hrCount = displayUsers.filter(u => u.role === 'hr').length;
let adminCount = displayUsers.filter(u => u.role === 'admin').length;
%>

<!-- MAIN CONTENT -->
<div class="flex-1 ml-60 flex flex-col h-screen overflow-hidden">

    <!-- TOP BAR -->
    <header class="bg-surface-bright border-b border-outline-variant flex justify-between items-center h-16 px-gutter sticky top-0 z-10">
        <!-- Search Bar -->
        <div class="flex-1 max-w-md">
            <div class="relative flex items-center focus-within:ring-2 focus-within:ring-outline-variant rounded-lg transition-shadow">
                <span class="material-symbols-outlined absolute left-3 text-on-surface-variant">search</span>
                <input
                    id="searchInput"
                    class="w-full pl-10 pr-4 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary placeholder:text-on-surface-variant/60"
                    placeholder="Search users by name, email, or role..."
                    type="text"
                />
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4">
            <button class="p-2 text-on-surface-variant hover:text-primary transition-colors relative group rounded-full hover:bg-surface-container-lowest" title="Notifications">
                <span class="material-symbols-outlined">notifications</span>
                <span class="absolute top-2 right-2 w-2 h-2 bg-secondary rounded-full ring-2 ring-surface-bright"></span>
            </button>

            <div class="h-9 w-9 rounded-full overflow-hidden border border-outline-variant cursor-pointer flex items-center justify-center bg-surface-container-high font-bold text-primary">
                <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="flex-1 overflow-y-auto p-margin-page">
        <div class="max-w-[1440px] mx-auto flex flex-col gap-stack-lg">

        <!-- PAGE HEADER -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h2 class="text-headline-xl font-headline-xl text-primary tracking-tight">
                    User Directory
                </h2>
                <p class="text-body-md text-on-surface-variant mt-1">
                    Manage system users, roles, contact details, and account profiles.
                </p>
            </div>

            <button
                onclick="openAddUserModal()"
                class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md hover:bg-primary/90 transition-colors flex items-center gap-2 w-fit shadow-sm cursor-pointer"
            >
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                Add New User
            </button>
        </div>

        <!-- STATS CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 hover:border-outline transition-colors shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-label-md uppercase tracking-wider text-on-surface-variant">Total Users</span>
                    <span class="material-symbols-outlined text-outline">group</span>
                </div>
                <div class="text-headline-xl font-headline-xl text-primary"><%= totalUserCount %></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 hover:border-outline transition-colors shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-label-md uppercase tracking-wider text-on-surface-variant">Employees</span>
                    <span class="material-symbols-outlined text-secondary">badge</span>
                </div>
                <div class="text-headline-xl font-headline-xl text-primary"><%= empCount %></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 hover:border-outline transition-colors shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-label-md uppercase tracking-wider text-on-surface-variant">HR Managers</span>
                    <span class="material-symbols-outlined text-tertiary">manage_accounts</span>
                </div>
                <div class="text-headline-xl font-headline-xl text-primary"><%= hrCount %></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 hover:border-outline transition-colors shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-label-md uppercase tracking-wider text-on-surface-variant">Admins</span>
                    <span class="material-symbols-outlined text-primary">admin_panel_settings</span>
                </div>
                <div class="text-headline-xl font-headline-xl text-primary"><%= adminCount %></div>
            </div>
        </div>

        <!-- FILTERS AND TAB CONTROLS -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
            <!-- Filter Tabs -->
            <div class="flex gap-2 w-full sm:w-auto overflow-x-auto pb-2 sm:pb-0">
                <button
                    id="tab-all"
                    class="role-tab-btn px-4 py-1.5 rounded-full bg-primary text-on-primary font-label-md whitespace-nowrap transition-colors"
                    onclick="filterRole('all', this)"
                >
                    All Users
                    <span class="ml-1.5 bg-surface-container-high text-on-surface px-2 py-0.5 rounded-full text-[11px]"><%= totalUserCount %></span>
                </button>

                <button
                    id="tab-employee"
                    class="role-tab-btn px-4 py-1.5 rounded-full hover:bg-surface-container text-on-surface-variant font-label-md transition-colors whitespace-nowrap"
                    onclick="filterRole('employee', this)"
                >
                    Employees
                    <span class="ml-1.5 bg-surface-container-high text-on-surface px-2 py-0.5 rounded-full text-[11px]"><%= empCount %></span>
                </button>

                <button
                    id="tab-hr"
                    class="role-tab-btn px-4 py-1.5 rounded-full hover:bg-surface-container text-on-surface-variant font-label-md transition-colors whitespace-nowrap"
                    onclick="filterRole('hr', this)"
                >
                    HR Managers
                    <span class="ml-1.5 bg-surface-container-high text-on-surface px-2 py-0.5 rounded-full text-[11px]"><%= hrCount %></span>
                </button>

                <button
                    id="tab-admin"
                    class="role-tab-btn px-4 py-1.5 rounded-full hover:bg-surface-container text-on-surface-variant font-label-md transition-colors whitespace-nowrap"
                    onclick="filterRole('admin', this)"
                >
                    Admins
                    <span class="ml-1.5 bg-surface-container-high text-on-surface px-2 py-0.5 rounded-full text-[11px]"><%= adminCount %></span>
                </button>
            </div>

            <!-- Page Size Selector -->
            <div class="flex items-center gap-2">
                <span class="text-label-md text-on-surface-variant">Rows per page:</span>
                <select
                    id="pageSizeSelect"
                    class="bg-surface-bright border border-outline-variant rounded-lg px-2 py-1 text-label-md text-on-surface focus:outline-none focus:border-primary"
                    onchange="changePageSize(this.value)"
                >
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>

        <!-- USERS TABLE -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[800px]">
                    <thead>
                        <tr class="bg-surface-bright border-b border-outline-variant">
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider w-16">Profile</th>
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider">User Name</th>
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider">Email Address</th>
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider">Phone / Contact</th>
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider">Role</th>
                            <th class="py-3.5 px-6 font-label-sm text-on-surface-variant uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="userTableBody" class="divide-y divide-outline-variant/50">
                        <% if (displayUsers && displayUsers.length > 0) { %>
                            <% displayUsers.forEach(function(u) { %>
                                <tr class="user-row hover:bg-surface-container-low transition-colors group cursor-pointer" data-role="<%= u.role %>" onclick="window.location='/admin/user/<%= u._id %>'">
                                    <!-- Avatar -->
                                    <td class="py-4 px-6">
                                        <div class="w-10 h-10 rounded-full bg-surface-container-high border border-outline-variant overflow-hidden flex items-center justify-center font-bold text-primary">
                                            <% if (u.profileImage && u.profileImage.length > 0) { %>
                                                <img class="w-full h-full object-cover" src="data:<%=u.imageType%>;base64,<%=u.profileImage.toString('base64')%>" alt="<%=u.fullname%>" />
                                            <% } else { %>
                                                <span><%= u.fullname ? u.fullname.charAt(0).toUpperCase() : 'U' %></span>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Fullname -->
                                    <td class="py-4 px-6 font-medium text-primary font-body-md">
                                        <a href="/admin/user/<%= u._id %>" class="hover:underline hover:text-secondary"><%= u.fullname %></a>
                                    </td>

                                    <!-- Email -->
                                    <td class="py-4 px-6 text-on-surface-variant font-body-md">
                                        <%= u.email %>
                                    </td>

                                    <!-- Phone -->
                                    <td class="py-4 px-6 text-on-surface-variant font-body-md">
                                        <%= u.phone || 'N/A' %>
                                    </td>

                                    <!-- Role Badge -->
                                    <td class="py-4 px-6">
                                        <% if(u.role === "admin") { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm bg-primary text-on-primary">Admin</span>
                                        <% } else if(u.role === "employee") { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm bg-secondary text-on-secondary">Employee</span>
                                        <% } else if(u.role === "hr") { %>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm bg-tertiary text-on-tertiary">HR Manager</span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-4 px-6 text-right">
                                        <div class="flex items-center justify-end gap-2 opacity-80 group-hover:opacity-100 transition-opacity" onclick="event.stopPropagation()">
                                            <a href="/admin/user/<%= u._id %>" class="p-1 text-on-surface-variant hover:text-primary transition-colors" title="View Profile">
                                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                                            </a>
                                            <a href="/admin/users/delete/<%= u._id %>" class="p-1 text-error hover:bg-error-container/30 rounded transition-colors" title="Delete User" onclick="return confirm('Are you sure you want to delete this user?')">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr id="noDataRow">
                                <td colspan="6" class="py-12 text-center text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[36px] text-outline mb-2">person_off</span>
                                    <p class="font-headline-md">No users found</p>
                                    <p class="text-body-md text-on-surface-variant/70 mt-1">Try adjusting your search terms or filter selection.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION FOOTER -->
            <div class="border-t border-outline-variant px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-bright">
                <p class="text-label-md text-on-surface-variant">
                    Showing <span id="showingStart">1</span> to <span id="showingEnd"><%= Math.min(10, totalUserCount) %></span> of <span id="totalFilteredCount"><%= totalUserCount %></span> entries
                </p>

                <div class="flex items-center gap-1.5" id="paginationButtons">
                    <button
                        id="prevPageBtn"
                        class="p-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                        onclick="goToPage(currentPage - 1)"
                    >
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>

                    <div id="pageNumbersContainer" class="flex gap-1"></div>

                    <button
                        id="nextPageBtn"
                        class="p-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                        onclick="goToPage(currentPage + 1)"
                    >
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- ADD USER MODAL POPUP -->
<div id="addUserModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden opacity-0 transition-all duration-300">
    <div id="addUserModalBox" class="bg-surface-bright border border-outline-variant rounded-2xl max-w-lg w-full p-6 shadow-2xl transform scale-95 transition-all duration-300 relative mx-4">
        <!-- Close Button -->
        <button onclick="closeAddUserModal()" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary p-1.5 rounded-lg hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>

        <!-- Modal Header -->
        <div class="flex items-center gap-3 mb-4 pb-4 border-b border-outline-variant/60">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[22px]">person_add</span>
            </div>
            <div>
                <h3 class="text-headline-md font-bold text-primary">Add New User</h3>
                <p class="text-label-sm text-on-surface-variant">Register a new system user profile</p>
            </div>
        </div>

        <!-- Form -->
        <form action="/register" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block text-label-md font-medium text-on-surface mb-1">Full Name</label>
                <input type="text" name="fullname" required placeholder="John Doe" class="w-full px-3.5 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary" />
            </div>

            <div>
                <label class="block text-label-md font-medium text-on-surface mb-1">Email Address</label>
                <input type="email" name="email" required placeholder="john.doe@company.com" class="w-full px-3.5 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-label-md font-medium text-on-surface mb-1">Password</label>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full px-3.5 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary" />
                </div>
                <div>
                    <label class="block text-label-md font-medium text-on-surface mb-1">Confirm Password</label>
                    <input type="password" name="confirmPassword" required placeholder="••••••••" class="w-full px-3.5 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-label-md font-medium text-on-surface mb-1">Phone Number</label>
                    <input type="text" name="phone" placeholder="+1 234 567 890" class="w-full px-3.5 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md focus:outline-none focus:border-primary" />
                </div>
                <div>
                    <label class="block text-label-md font-medium text-on-surface mb-1">Profile Image</label>
                    <input type="file" name="profileImage" accept="image/*" class="w-full px-2 py-1.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-label-sm text-on-surface focus:outline-none" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-outline-variant/60">
                <button type="button" onclick="closeAddUserModal()" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-label-md transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-on-primary font-label-md transition-colors shadow-sm flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>

<!-- JAVASCRIPT FOR PAGINATION, SEARCH & MODAL -->
<script>
    function openAddUserModal() {
        const modal = document.getElementById('addUserModal');
        const box = document.getElementById('addUserModalBox');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            box.classList.remove('scale-95');
            box.classList.add('scale-100');
        }, 10);
    }

    function closeAddUserModal() {
        const modal = document.getElementById('addUserModal');
        const box = document.getElementById('addUserModalBox');
        modal.classList.add('opacity-0');
        box.classList.remove('scale-100');
        box.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    let activeRoleFilter = 'all';
    let currentPage = 1;
    let pageSize = 10;
    let filteredRows = [];

    document.addEventListener("DOMContentLoaded", () => {
        initPagination();

        const searchInput = document.getElementById("searchInput");
        if (searchInput) {
            searchInput.addEventListener("keyup", () => {
                currentPage = 1;
                initPagination();
            });
        }
    });

    function filterRole(role, element) {
        activeRoleFilter = role;
        currentPage = 1;

        document.querySelectorAll('.role-tab-btn').forEach(btn => {
            btn.classList.remove('bg-primary', 'text-on-primary');
            btn.classList.add('hover:bg-surface-container', 'text-on-surface-variant');
        });

        if (element) {
            element.classList.remove('hover:bg-surface-container', 'text-on-surface-variant');
            element.classList.add('bg-primary', 'text-on-primary');
        }

        initPagination();
    }

    function changePageSize(val) {
        pageSize = parseInt(val, 10);
        currentPage = 1;
        initPagination();
    }

    function initPagination() {
        const searchInput = document.getElementById("searchInput");
        const query = searchInput ? searchInput.value.toLowerCase().trim() : "";
        const allRows = Array.from(document.querySelectorAll("tbody tr.user-row"));

        filteredRows = allRows.filter(row => {
            const role = row.getAttribute("data-role");
            const text = row.innerText.toLowerCase();
            const matchesRole = (activeRoleFilter === 'all' || role === activeRoleFilter);
            const matchesSearch = text.includes(query);
            return matchesRole && matchesSearch;
        });

        const totalFiltered = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(totalFiltered / pageSize));

        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        allRows.forEach(row => row.style.display = "none");

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, totalFiltered);

        for (let i = startIndex; i < endIndex; i++) {
            if (filteredRows[i]) {
                filteredRows[i].style.display = "";
            }
        }

        const noDataRow = document.getElementById("noDataRow");
        if (noDataRow) {
            noDataRow.style.display = (totalFiltered === 0) ? "" : "none";
        }

        const startDisp = document.getElementById("showingStart");
        const endDisp = document.getElementById("showingEnd");
        const totalDisp = document.getElementById("totalFilteredCount");

        if (startDisp) startDisp.innerText = totalFiltered === 0 ? 0 : startIndex + 1;
        if (endDisp) endDisp.innerText = endIndex;
        if (totalDisp) totalDisp.innerText = totalFiltered;

        renderPageButtons(totalPages);
    }

    function renderPageButtons(totalPages) {
        const container = document.getElementById("pageNumbersContainer");
        const prevBtn = document.getElementById("prevPageBtn");
        const nextBtn = document.getElementById("nextPageBtn");

        if (prevBtn) prevBtn.disabled = (currentPage === 1);
        if (nextBtn) nextBtn.disabled = (currentPage === totalPages || totalPages === 0);

        if (!container) return;
        container.innerHTML = "";

        for (let page = 1; page <= totalPages; page++) {
            const pageBtn = document.createElement("button");
            pageBtn.className = `w-8 h-8 rounded-lg font-label-md text-label-md flex items-center justify-center transition-colors ${
                page === currentPage
                    ? 'bg-primary text-on-primary font-bold shadow-sm'
                    : 'border border-outline-variant text-on-surface-variant hover:bg-surface-container'
            }`;
            pageBtn.innerText = page;
            pageBtn.onclick = () => goToPage(page);
            container.appendChild(pageBtn);
        }
    }

    function goToPage(page) {
        const totalPages = Math.ceil(filteredRows.length / pageSize);
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            initPagination();
        }
    }
</script>

</body>
</html>
