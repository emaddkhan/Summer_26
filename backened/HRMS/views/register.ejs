<!DOCTYPE html>
<html class="h-full bg-surface-bright text-on-surface" lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Join MINI HRMS</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap"
    rel="stylesheet"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script>
    tailwind.config = {
      darkMode: "class",

      theme: {
        extend: {
          colors: {
            "surface-bright": "#fbf8ff",
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#f4f2fd",
            "surface-container-high": "#e8e7f1",
            "surface-container": "#eeedf7",
            "primary": "#000000",
            "primary-container": "#1c1b1d",
            "on-primary": "#ffffff",
            "on-surface": "#1a1b22",
            "on-surface-variant": "#47464a",
            "outline": "#78767b",
            "outline-variant": "#c8c5ca",
            "error": "#ba1a1a"
          },

          fontFamily: {
            geist: ["Geist", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>


<body class="h-full flex antialiased bg-surface-bright text-on-surface">

  <!-- Split Screen Layout -->
  <div class="flex min-h-screen w-full">


    <!-- ================================= -->
    <!-- LEFT SIDE - REGISTER FORM -->
    <!-- ================================= -->

    <div
      class="flex-1 flex flex-col justify-center py-12 px-4
             sm:px-6 lg:flex-none lg:px-20 xl:px-24
             bg-surface-container-lowest
             border-r border-outline-variant
             w-full max-w-2xl"
    >

      <div class="mx-auto w-full max-w-sm lg:w-96">


        <!-- Header -->
        <div>

          <h1
            class="text-4xl font-black tracking-tight mb-2"
          >
            Join MINI HRMS
          </h1>

          <p class="text-sm text-on-surface-variant">
            Create your account to access the management portal.
          </p>

        </div>


        <!-- ================================= -->
        <!-- FLASH ERROR -->
        <!-- ================================= -->

        <% if (typeof error !== "undefined" && error.length > 0) { %>

          <div
            class="mt-6 p-4 rounded-lg
                   bg-red-50 border border-red-200
                   flex gap-3 items-start"
          >

            <span
              class="material-symbols-outlined text-red-600 text-xl"
            >
              error
            </span>

            <p class="text-sm font-medium text-red-700">
              <%= error[0] %>
            </p>

          </div>

        <% } %>


        <!-- ================================= -->
        <!-- FLASH SUCCESS -->
        <!-- ================================= -->

        <% if (typeof success !== "undefined" && success.length > 0) { %>

          <div
            class="mt-6 p-4 rounded-lg
                   bg-green-50 border border-green-200
                   flex gap-3 items-start"
          >

            <span
              class="material-symbols-outlined text-green-600 text-xl"
            >
              check_circle
            </span>

            <p class="text-sm font-medium text-green-700">
              <%= success[0] %>
            </p>

          </div>

        <% } %>


        <!-- Alert Message -->
        <div
          class="mt-6 p-4 rounded-lg
                 bg-surface-container-low
                 border border-outline-variant
                 flex gap-3 items-start"
        >

          <span
            class="material-symbols-outlined
                   text-on-surface-variant text-xl shrink-0"
          >
            info
          </span>

          <p
            class="text-xs font-medium
                   text-on-surface-variant"
          >
            New accounts are created as Employee.
            Admin can assign HR or Admin roles.
          </p>

        </div>


        <!-- ================================= -->
        <!-- REGISTER FORM -->
        <!-- ================================= -->

        <div class="mt-8">

          <form
            action="/register"
            method="POST"
            class="space-y-6"
          >


            <!-- Profile Picture -->
            <div class="flex justify-center mb-6">

              <div class="relative group cursor-pointer">

                <div
                  class="w-24 h-24 rounded-full
                         bg-surface-container-high
                         border-2 border-dashed
                         border-outline-variant
                         flex items-center justify-center
                         overflow-hidden
                         transition-colors
                         group-hover:border-primary
                         group-hover:bg-surface-container-low"
                >

                  <span
                    class="material-symbols-outlined
                           text-outline-variant
                           group-hover:text-primary
                           text-3xl"
                  >
                    add_a_photo
                  </span>

                </div>


                <div
                  class="absolute bottom-0 right-0
                         bg-white rounded-full p-1
                         border border-outline-variant
                         shadow-sm"
                >

                  <span
                    class="material-symbols-outlined
                           text-primary text-sm"
                  >
                    edit
                  </span>

                </div>

              </div>

            </div>


            <!-- Full Name -->
            <div>

              <label
                class="block text-xs font-semibold
                       text-on-surface mb-1.5"
                for="name"
              >
                Full Name
              </label>

              <div class="mt-1">

                <input
                  autocomplete="name"
                  class="appearance-none block w-full
                         px-3 py-2
                         border border-outline-variant
                         rounded-lg
                         bg-white
                         placeholder-outline
                         text-sm
                         focus:outline-none
                         focus:ring-1
                         focus:ring-primary
                         focus:border-primary
                         transition-colors"
                  id="name"
                  name="fullname"
                  required
                  type="text"
                  value="<%= typeof fullname !== 'undefined' ? fullname : '' %>"
                  placeholder="Enter your full name"
                />

              </div>

            </div>


            <!-- Email -->
            <div>

              <label
                class="block text-xs font-semibold
                       text-on-surface mb-1.5"
                for="email"
              >
                Email address
              </label>

              <div class="mt-1">

                <input
                  autocomplete="email"
                  class="appearance-none block w-full
                         px-3 py-2
                         border border-outline-variant
                         rounded-lg
                         bg-white
                         placeholder-outline
                         text-sm
                         focus:outline-none
                         focus:ring-1
                         focus:ring-primary
                         focus:border-primary
                         transition-colors"
                  id="email"
                  name="email"
                  required
                  type="email"
                  value="<%= typeof email !== 'undefined' ? email : '' %>"
                  placeholder="name@company.com"
                />

              </div>

            </div>


            <!-- Password -->
            <div>

              <label
                class="block text-xs font-semibold
                       text-on-surface mb-1.5"
                for="password"
              >
                Password
              </label>

              <div class="mt-1">

                <input
                  autocomplete="new-password"
                  class="appearance-none block w-full
                         px-3 py-2
                         border border-outline-variant
                         rounded-lg
                         bg-white
                         placeholder-outline
                         text-sm
                         focus:outline-none
                         focus:ring-1
                         focus:ring-primary
                         focus:border-primary
                         transition-colors"
                  id="password"
                  name="password"
                  required
                  type="password"
                  placeholder="Create your password"
                />

              </div>

            </div>


            <!-- Confirm Password -->
            <div>

              <label
                class="block text-xs font-semibold
                       text-on-surface mb-1.5"
                for="confirm-password"
              >
                Confirm Password
              </label>

              <div class="mt-1">

                <input
                  autocomplete="new-password"
                  class="appearance-none block w-full
                         px-3 py-2
                         border border-outline-variant
                         rounded-lg
                         bg-white
                         placeholder-outline
                         text-sm
                         focus:outline-none
                         focus:ring-1
                         focus:ring-primary
                         focus:border-primary
                         transition-colors"
                  id="confirm-password"
                  name="confirmPassword"
                  required
                  type="password"
                  placeholder="Confirm your password"
                />

              </div>

            </div>


            <!-- Submit -->
            <div>

              <button
                class="w-full flex justify-center
                       py-2.5 px-4
                       border border-transparent
                       rounded-lg shadow-sm
                       text-sm font-semibold
                       text-white
                       bg-black
                       hover:bg-primary-container
                       focus:outline-none
                       focus:ring-2
                       focus:ring-offset-2
                       focus:ring-primary
                       transition-colors
                       cursor-pointer"
                type="submit"
              >
                Create Account
              </button>

            </div>

          </form>


          <!-- Login Link -->
          <div class="mt-6 text-center">

            <p
              class="text-sm
                     text-on-surface-variant"
            >
              Already have an account?

              <a
                class="font-medium
                       text-primary
                       hover:text-primary-container
                       transition-colors
                       underline"
                href="/"
              >
                Sign in
              </a>

            </p>

          </div>

        </div>

      </div>

    </div>


    <!-- ================================= -->
    <!-- RIGHT SIDE - IMAGE -->
    <!-- ================================= -->

    <div
      class="hidden lg:block
             relative w-0 flex-1
             bg-surface-container-low"
    >

      <div
        class="absolute inset-0
               h-full w-full
               object-cover
               bg-cover bg-center"
        style="
          background-image:
          url('/images/corporate.jpg');
        "
      >
      </div>


      <!-- Gradient Overlay -->
      <div
        class="absolute inset-0
               bg-gradient-to-t
               from-white/80
               to-transparent"
      >
      </div>


      <!-- Quote -->
      <div
        class="absolute
               bottom-12
               left-12
               right-12
               text-on-surface"
      >

        <div
          class="p-8
                 backdrop-blur-md
                 bg-white/80
                 border border-outline-variant
                 rounded-xl
                 max-w-lg"
        >

          <span
            class="material-symbols-outlined
                   text-primary
                   mb-4
                   text-3xl"
          >
            format_quote
          </span>

          <p
            class="text-lg
                   font-semibold
                   mb-4"
          >
            Streamlining HR operations with a focus on speed,
            clarity, and precision.
          </p>

          <p
            class="text-xs
                   font-semibold
                   text-on-surface-variant
                   uppercase
                   tracking-wider"
          >
            MINI HRMS Platform
          </p>

        </div>

      </div>

    </div>

  </div>

</body>

</html>

