<!DOCTYPE html>
<html class="h-full bg-surface-bright text-on-surface" lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Join MINI HRMS</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap"
    rel="stylesheet"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "surface-bright": "#fbf8ff",
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#f4f2fd",
            "surface-container-high": "#e8e7f1",
            "primary": "#000000",
            "primary-container": "#1c1b1d",
            "on-primary": "#ffffff",
            "on-surface": "#1a1b22",
            "on-surface-variant": "#47464a",
            "outline-variant": "#c8c5ca",
            "error": "#ba1a1a"
          },

          fontFamily: {
            geist: ["Geist", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>


<body
  class="h-full antialiased bg-surface-bright text-on-surface font-geist"
>


  <div class="flex min-h-screen w-full">


    <!-- ================================================= -->
    <!-- LEFT SIDE -->
    <!-- ================================================= -->

    <div
      class="w-full lg:w-[50%]
             min-h-screen lg:h-screen
             flex flex-col justify-center
             px-6 sm:px-10 lg:px-14 xl:px-20
             bg-white
             border-r border-outline-variant
             overflow-y-auto"
    >

      <div class="w-full max-w-lg mx-auto py-6">


        <!-- HEADER -->
        <div class="mb-4">

          <h1
            class="text-3xl xl:text-4xl
                   font-black
                   tracking-tight"
          >
            Join MINI HRMS
          </h1>

          <p
            class="text-sm
                   text-on-surface-variant
                   mt-1"
          >
            Create your account to access the management portal.
          </p>

        </div>


        <!-- ================================================= -->
        <!-- FLASH ERROR -->
        <!-- ================================================= -->

        <% if (typeof error !== "undefined" && error.length > 0) { %>

          <div
            class="mb-3
                   p-3
                   rounded-lg
                   bg-red-50
                   border border-red-200
                   flex items-center gap-2"
          >

            <span
              class="material-symbols-outlined
                     text-red-600
                     text-lg"
            >
              error
            </span>

            <p class="text-xs font-semibold text-red-700">
              <%= error[0] %>
            </p>

          </div>

        <% } %>


        <!-- ================================================= -->
        <!-- FLASH SUCCESS -->
        <!-- ================================================= -->

        <% if (typeof success !== "undefined" && success.length > 0) { %>

          <div
            class="mb-3
                   p-3
                   rounded-lg
                   bg-green-50
                   border border-green-200
                   flex items-center gap-2"
          >

            <span
              class="material-symbols-outlined
                     text-green-600
                     text-lg"
            >
              check_circle
            </span>

            <p class="text-xs font-semibold text-green-700">
              <%= success[0] %>
            </p>

          </div>

        <% } %>


        <!-- ================================================= -->
        <!-- INFO BOX -->
        <!-- ================================================= -->

        <div
          class="p-3
                 rounded-lg
                 bg-surface-container-low
                 border border-outline-variant
                 flex gap-2
                 items-center"
        >

          <span
            class="material-symbols-outlined
                   text-on-surface-variant
                   text-lg
                   shrink-0"
          >
            info
          </span>

          <p
            class="text-xs
                   font-medium
                   text-on-surface-variant
                   leading-4"
          >
            New accounts are created as Employee.
            Admin can assign HR or Admin roles.
          </p>

        </div>


        <!-- ================================================= -->
        <!-- FORM -->
        <!-- ================================================= -->

        <form
          action="/register"
          method="POST"
          enctype="multipart/form-data"
          class="mt-4"
        >


          <!-- ================================================= -->
          <!-- PROFILE IMAGE -->
          <!-- ================================================= -->

          <div class="flex justify-center mb-4">

            <label
              for="profileImage"
              class="relative cursor-pointer group"
            >

              <!-- Image Preview -->
              <div
                class="w-20 h-20
                       rounded-full
                       bg-surface-container-high
                       border-2 border-dashed
                       border-outline-variant
                       flex items-center justify-center
                       overflow-hidden
                       group-hover:border-black
                       transition"
              >

                <img
                  id="imagePreview"
                  src=""
                  alt="Profile Preview"
                  class="hidden w-full h-full object-cover"
                />

                <span
                  id="uploadIcon"
                  class="material-symbols-outlined
                         text-outline-variant
                         group-hover:text-black
                         text-2xl"
                >
                  add_a_photo
                </span>

              </div>


              <!-- Edit Icon -->
              <div
                class="absolute
                       bottom-0
                       right-0
                       w-7 h-7
                       bg-black
                       text-white
                       rounded-full
                       flex items-center justify-center
                       shadow"
              >

                <span class="material-symbols-outlined text-sm">
                  edit
                </span>

              </div>


              <!-- REAL FILE INPUT -->
              <input
                id="profileImage"
                name="profileImage"
                type="file"
                accept="image/png,image/jpeg,image/jpg,image/webp"
                class="hidden"
                enctype="multipart/form-data"
              />

            </label>

          </div>


          <!-- ================================================= -->
          <!-- FORM FIELDS -->
          <!-- ================================================= -->

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-3">


            <!-- FULL NAME -->
            <div class="sm:col-span-2">

              <label
                for="name"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Full Name
              </label>

              <input
                id="name"
                name="fullname"
                type="text"
                required
                autocomplete="name"
                placeholder="Enter your full name"
                value="<%= typeof fullname !== 'undefined' ? fullname : '' %>"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


            <!-- EMAIL -->
            <div>

              <label
                for="email"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Email address
              </label>

              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="name@company.com"
                value="<%= typeof email !== 'undefined' ? email : '' %>"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


            <!-- PHONE -->
            <div>

              <label
                for="phone"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Phone Number
              </label>

              <input
                id="phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="+92 300 1234567"
                value="<%= typeof phone !== 'undefined' ? phone : '' %>"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


            <!-- ADDRESS -->
            <div class="sm:col-span-2">

              <label
                for="address"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Address
              </label>

              <input
                id="address"
                name="address"
                type="text"
                required
                autocomplete="street-address"
                placeholder="Enter your address"
                value="<%= typeof address !== 'undefined' ? address : '' %>"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


            <!-- PASSWORD -->
            <div>

              <label
                for="password"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Password
              </label>

              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="new-password"
                placeholder="Password"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


            <!-- CONFIRM PASSWORD -->
            <div>

              <label
                for="confirmPassword"
                class="block text-xs
                       font-semibold
                       text-on-surface
                       mb-1"
              >
                Confirm Password
              </label>

              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                required
                autocomplete="new-password"
                placeholder="Confirm password"
                class="w-full
                       px-3 py-2
                       text-sm
                       rounded-lg
                       border border-outline-variant
                       bg-white
                       outline-none
                       focus:border-black
                       focus:ring-1
                       focus:ring-black
                       transition"
              />

            </div>


          </div>


          <!-- ================================================= -->
          <!-- SUBMIT -->
          <!-- ================================================= -->

          <button
            type="submit"
            class="w-full
                   mt-4
                   py-2.5
                   rounded-lg
                   bg-black
                   text-white
                   text-sm
                   font-semibold
                   hover:bg-primary-container
                   active:scale-[0.99]
                   transition
                   cursor-pointer"
          >
            Create Account
          </button>


        </form>


        <!-- ================================================= -->
        <!-- LOGIN LINK -->
        <!-- ================================================= -->

        <div class="mt-3 text-center">

          <p
            class="text-xs
                   text-on-surface-variant
                   font-medium"
          >
            Already have an account?

            <a
              href="/"
              class="font-semibold
                     text-black
                     underline
                     underline-offset-2
                     hover:no-underline"
            >
              Sign in
            </a>

          </p>

        </div>


      </div>

    </div>


    <!-- ================================================= -->
    <!-- RIGHT SIDE -->
    <!-- ================================================= -->

    <div
      class="hidden lg:block
             relative
             w-0
             flex-1
             bg-surface-container-low"
    >

      <!-- Background Image -->
      <div
        class="absolute inset-0
               h-full w-full
               bg-cover
               bg-center"
        style="background-image: url('/images/corporate.jpg');"
      >
      </div>


      <!-- Overlay -->
      <div
        class="absolute inset-0
               bg-gradient-to-t
               from-white/90
               via-white/10
               to-transparent"
      >
      </div>


      <!-- Quote Card -->
      <div
        class="absolute
               bottom-10
               left-10
               right-10"
      >

        <div
          class="p-6
                 backdrop-blur-md
                 bg-white/80
                 border border-outline-variant
                 rounded-xl
                 max-w-lg"
        >

          <span
            class="material-symbols-outlined
                   text-black
                   mb-3
                   text-2xl"
          >
            format_quote
          </span>

          <p
            class="text-lg
                   font-semibold
                   leading-7
                   mb-3"
          >
            Streamlining HR operations with a focus on speed,
            clarity, and precision.
          </p>

          <p
            class="text-xs
                   font-semibold
                   text-on-surface-variant
                   uppercase
                   tracking-wider"
          >
            MINI HRMS Platform
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- IMAGE PREVIEW SCRIPT -->
  <!-- ================================================= -->

  <script>

    const profileImage = document.getElementById("profileImage");
    const imagePreview = document.getElementById("imagePreview");
    const uploadIcon = document.getElementById("uploadIcon");

    profileImage.addEventListener("change", function () {

      const file = this.files[0];

      if (!file) {
        imagePreview.classList.add("hidden");
        uploadIcon.classList.remove("hidden");
        imagePreview.src = "";
        return;
      }

      // Make sure selected file is an image
      if (!file.type.startsWith("image/")) {

        alert("Please select a valid image.");

        this.value = "";

        imagePreview.classList.add("hidden");
        uploadIcon.classList.remove("hidden");

        return;
      }

      const imageURL = URL.createObjectURL(file);

      imagePreview.src = imageURL;

      imagePreview.classList.remove("hidden");

      uploadIcon.classList.add("hidden");

    });

  </script>


</body>

</html>
