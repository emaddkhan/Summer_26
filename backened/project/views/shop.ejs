<%- include('./partials/header') %>
<% if(success && success.length > 0) { %>

  <div
    id="flash-message"
    class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-green-500 text-white"
  >
    <span><%= success[0] %></span>
  </div>

  <script>
    setTimeout(() => {
      const flashMessage = document.getElementById("flash-message");

      if (flashMessage) {
        flashMessage.remove();
      }
    }, 3000);
  </script>

<% } %>
<div class="w-full h-screen flex items-start px-20 py-20">

    <div class="w-[25%] flex h-screen flex-col items-start">

        <div class="flex items-center gap-2">
            <h3>Sort by</h3>

            <form action="/shop">
                <select class="border-[1px] px-2 py-1" name="sortby">
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                </select>
            </form>
        </div>

        <div class="flex flex-col mt-20">
            <a class="block w-fit mb-2" href="">New Collection</a>
            <a class="block w-fit mb-2" href="">All Products</a>
            <a class="block w-fit mb-2" href="">Discounted Products</a>
        </div>

        <div class="mt-32">
            <a class="block w-fit mb-2" href="">Filter by:</a>
            <a class="block w-fit mb-2" href="">Availability</a>
            <a class="block w-fit mb-2" href="">Discount</a>
        </div>

    </div>

    <div class="w-[75%] flex flex-col gap-5 h-screen">

        <div class="flex items-start gap-5">

            <div class="w-60">

                <div class="w-full h-52 flex items-center justify-center bg-gray-200">
                    <img class="h-[12rem]" src="" alt="">
                </div>

                <div class="flex justify-between bg-gray-300 items-center px-4 py-4">

                    <div>
                        <h3>Product Name</h3>
                        <h4>₹ 999</h4>
                    </div>

                    <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white" href="">
                        <i class="ri-add-line"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>
```
