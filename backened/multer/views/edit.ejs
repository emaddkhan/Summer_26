<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full h-screen text-white bg-zinc-900 p-10">
        <h4 class="mb-5">Edit your post</h4>
        <form method="post" action="/update/<%=post._id%>">
            <textarea placeholder="What's on your mind?"  class="block px-3 py-2 w-1/4 bg-transparent border-1 outline-none boder-zinc-800 resize-none rounded-md" name="content"><%=post.content%></textarea>
            <input class="block px-3 py-2 bg-yellow-500 mt-2 rounded-md w-40" type="submit" value="Update post">
        </form>

    </div>
</body>
</html>