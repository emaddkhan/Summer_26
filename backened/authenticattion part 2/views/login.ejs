<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full p-10 h-screen text-white bg-zinc-900">
        <h1 class="text-3xl mb-3 font-semibold">Login your Account</h1>
        <form action="/login" method="post">
            <input class="px-3 py-2 rounded-md outline-none border-2 border-zinc-800 bg-transparent" type="text" name="email" placeholder="email" id="">
            <input class="px-3 py-2 rounded-md outline-none border-2 border-zinc-800 bg-transparent" type="password" name="password" placeholder="password" id="">
            
            <input class="px-8 py-2 rounded-md bg-blue-500" type="submit" value="Login">
        </form>
    </div>
</body>
</html>