<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    
    <div class="w-full min-h-screen bg-zinc-900 p-6 md:p-10">
    <div class="max-w-7xl mx-auto">
        <div class="mb-8">
            <h1 class="text-white text-3xl md:text-4xl font-bold">
                Create User
            </h1>
            <p class="text-zinc-400 mt-1">
                Add a new user to your database.
            </p>
        </div>
        <div class="bg-zinc-800 border border-zinc-700 rounded-2xl p-6 mb-10 max-w-2xl">
            <form action="/create" method="post" class="space-y-5">
                <div>
                    <label for="name" class="block text-sm font-medium text-zinc-300 mb-2">
                        Full Name
                    </label>
                    <input
                        id="name"
                        type="text"
                        name="name"
                        placeholder="Enter full name"
                        required
                        class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
                    >
                </div>
                <div>
                    <label for="username" class="block text-sm font-medium text-zinc-300 mb-2">
                        Username
                    </label>
                    <input
                        id="username"
                        type="text"
                        name="username"
                        placeholder="Enter username"
                        required
                        class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
                    >
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">
                        Email Address
                    </label>
                    <input
                        id="email"
                        type="email"
                        name="email"
                        placeholder="example@email.com"
                        required
                        class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
                    >
                </div>
                <div>
                    <label for="image" class="block text-sm font-medium text-zinc-300 mb-2">
                        Profile Image URL
                    </label>
                    <input
                        id="image"
                        type="url"
                        name="image"
                        placeholder="https://example.com/image.jpg"
                        class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
                    >
                </div>
                <button
                    type="submit"
                    class="w-full py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg cursor-pointer transition"
                >
                    Create User
                </button>
            </form>
        </div>
        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="text-white text-2xl font-bold">
                    Users
                </h2>
                <p class="text-zinc-500 text-sm mt-1">
                    Manage your users
                </p>
            </div>
            <span class="px-3 py-1 bg-zinc-800 border border-zinc-700 text-zinc-300 rounded-full text-sm">
                <%= users.length %> Users
            </span>
        </div>
        <% if (users.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                <% users.forEach(user => { %>
                    <div class="bg-zinc-800 border border-zinc-700 rounded-2xl p-5 hover:border-zinc-500 hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center gap-4 mb-5">
                            <img
                                src="<%= user.image %>"
                                alt="<%= user.name %>"
                                class="w-16 h-16 rounded-full object-cover border-2 border-zinc-600"
                            >
                            <div class="min-w-0">
                                <h3 class="text-white font-semibold text-xl truncate capitalize">
                                    <%= user.name %>
                                </h3>
                                <p class="text-zinc-400 text-sm truncate">
                                    @<%= user.username %>
                                </p>
                            </div>
                        </div>
                        <div class="mb-5">
                            <p class="text-xs uppercase tracking-wide text-zinc-500 mb-1">
                                Email
                            </p>
                            <p class="text-zinc-300 text-sm truncate">
                                <%= user.email %>
                            </p>
                        </div>
                        <div class="flex gap-2">
                            <a
                                href="/edit/<%= user._id %>"
                                class="flex-1 text-center py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-lg transition"
                            >
                                Edit
                            </a>
                            <a
                                href="/delete/<%= user._id %>"
                                onclick="return confirm('Are you sure you want to delete this user?')"
                                class="flex-1 text-center py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition"
                            >
                                Delete
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="border border-dashed border-zinc-700 rounded-2xl p-12 text-center">
                <h3 class="text-white text-xl font-semibold">
                    No users yet
                </h3>
                <p class="text-zinc-500 mt-2">
                    Create your first user using the form above.
                </p>
            </div>
        <% } %>
    </div>

</div>
</body>
</html>