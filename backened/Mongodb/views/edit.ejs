<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-800 p-10">

    <div class="max-w-xl">
        <h1 class="text-white text-3xl font-bold mb-2">
            Edit User
        </h1>
        <p class="text-zinc-400 mb-6">
            Update your information
        </p>
        <form action="/update/<%= user._id %>" method="post" class="space-y-5">
            <div>
                <label for="name" class="block text-sm font-medium text-zinc-300 mb-2">
                    Name
                </label>
                <input
                    id="name"
                    type="text"
                    name="newName"
                    value="<%= user.name %>"
                    placeholder="Enter your name"
                    class="w-full px-4 py-3 bg-zinc-700 border border-zinc-600 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-green-500 transition"
                >
            </div>
            <div>
                <label for="username" class="block text-sm font-medium text-zinc-300 mb-2">
                    Username
                </label>
                <input
                    id="username"
                    type="text"
                    name="newUsername"
                    value="<%= user.username %>"
                    placeholder="Enter username"
                    class="w-full px-4 py-3 bg-zinc-700 border border-zinc-600 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-green-500 transition"
                >
            </div>
            <div>
                <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">
                    Email
                </label>
                <input
                    id="email"
                    type="email"
                    name="newEmail"
                    value="<%= user.email %>"
                    placeholder="Enter email"
                    class="w-full px-4 py-3 bg-zinc-700 border border-zinc-600 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-green-500 transition"
                >
            </div>
            <div>
                <label for="image" class="block text-sm font-medium text-zinc-300 mb-2">
                    Image URL
                </label>
                <input
                    id="image"
                    type="text"
                    name="newImage"
                    value="<%= user.image %>"
                    placeholder="Enter image URL"
                    class="w-full px-4 py-3 bg-zinc-700 border border-zinc-600 rounded-lg text-white placeholder:text-zinc-500 outline-none focus:border-green-500 transition"
                >
            </div>
            <div class="flex gap-3 pt-2">
                <button
                    type="submit"
                    class="flex-1 px-5 py-3 bg-green-700 hover:bg-green-600 text-white font-medium rounded-lg cursor-pointer transition"
                >
                    Update User
                </button>
                <a
                    href="/"
                    class="px-5 py-3 bg-zinc-700 hover:bg-zinc-600 text-zinc-200 font-medium rounded-lg transition"
                >
                    Cancel
                </a>
            </div>
        </form>
    </div>

</div>
</body>
</html>