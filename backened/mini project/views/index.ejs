<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main min-h-screen w-full bg-zinc-900">
      <div class="form text-white p-10">
        <form  action="/create" method="POST" ">
            <input
          type="text"
          name="title"
          placeholder="Enter a task..."
          class="block w-full rounded-lg px-5 py-2 bg-zinc-800 text-white placeholder:text-zinc-500 border border-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <textarea
            name="details"
          placeholder="Enter task details..."
          class="block w-full rounded-lg resize-none px-5 py-2 mt-2 bg-zinc-800 text-white placeholder:text-zinc-500 border border-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        ></textarea>
        <input
          type="submit"
          value="Create Task"
          class="bg-blue-600 mt-2 text-white hover:bg-blue-700 hover:cursor-pointer px-8 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        </form>
      </div>
      <div class="task p-10 flex flex-wrap gap-3">
        <% if (files.length > 0) { %>

            <% files.forEach(function(file) { %>
                <div class="w-72 px-3 py-2 bg-zinc-800  mb-1 rounded-lg">
            <h1 class="text-white text-3xl tracking-tighter"><%=file%></h1>
            <a href="#" class="inline-block mt-1 text-sm text-blue-500 hover:text-blue-700">View Details</a>
        </div>
            <% }); %>

            <% } else { %>

                   <h3 class="text-zinc-600 text-2xl">No tasks yet...</h3>

            <% } %>
            <!-- <a href="#" class="inline-block mt-1 text-sm text-blue-500 hover:text-blue-700">View Details</a> -->
        </div>
        
      </div>
    </div>
    <script src="/javascripts/script.js"></script>
  </body>
</html>
